+  static constexpr int CUSTOM = 1;
+  int sleepScreen = CUSTOM;
+  bool pluginsEnabled = true;
+  uint64_t getTimedSleepScreenRefreshUs() { return 120000000; }
+} SETTINGS;
+namespace BoardConfig {
