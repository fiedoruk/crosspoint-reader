+// Executes the HAL capture methods with controlled GPIO interrupt boundaries.
+#include <cassert>
+#include <cstdint>
+
+#define IRAM_ATTR
+#define LOG_ERR(...)
+struct portMUX_TYPE {
+  int depth = 0;
+};
+#define portMUX_INITIALIZER_UNLOCKED \
+  {                                  \
+  }
+#define portENTER_CRITICAL(mux) (++(mux)->depth)
+#define portEXIT_CRITICAL(mux) (--(mux)->depth)
+#define portENTER_CRITICAL_ISR(mux) portENTER_CRITICAL(mux)
+#define portEXIT_CRITICAL_ISR(mux) portEXIT_CRITICAL(mux)
+using gpio_num_t = int;
+constexpr int ESP_OK = 0, ESP_ERR_INVALID_STATE = 1;
+constexpr int GPIO_INTR_POSEDGE = 3, GPIO_INTR_NEGEDGE = 4;
+static int serviceResult = ESP_OK, edgeResult = ESP_OK, attachResult = ESP_OK;
+static int edge = 0, installs = 0, removes = 0, disables = 0;
+static bool physicalPower = false;
+static void (*handler)(void*) = nullptr;
+static void* argument = nullptr;
+int gpio_install_isr_service(int flags) {
+  assert(flags == 0);
+  ++installs;
+  return serviceResult;
+}
+int gpio_set_intr_type(gpio_num_t pin, int type) {
+  assert(pin == 3);
+  edge = type;
+  return edgeResult;
+}
+int gpio_isr_handler_add(gpio_num_t pin, void (*callback)(void*), void* context) {
+  assert(pin == 3);
+  if (attachResult != ESP_OK) return attachResult;
+  handler = callback;
+  argument = context;
+  return ESP_OK;
+}
+int gpio_intr_disable(gpio_num_t pin) {
+  assert(pin == 3);
+  ++disables;
+  return ESP_OK;
+}
+int gpio_isr_handler_remove(gpio_num_t pin) {
+  assert(pin == 3);
+  ++removes;
+  handler = nullptr;
+  argument = nullptr;
+  return ESP_OK;
+}
+namespace BoardConfig {
+static bool supported = true;
+bool isSticky() { return supported; }
+bool isX4Pro() { return false; }
+struct Profile {
+  struct Input {
+    int8_t power = 3;
+    bool powerActiveHigh = false;
+  } input;
+} ACTIVE;
+}  // namespace BoardConfig
+class HalGPIO {
+ public:
+  bool capturedPowerPress = false;
+  mutable portMUX_TYPE powerCaptureMux = portMUX_INITIALIZER_UNLOCKED;
+  int8_t capturedPowerPin = -1;
+  static void capturePowerPress(void*);
+  bool rawPowerButtonPressed() const { return physicalPower; }
+  bool beginPowerPressCapture();
+  bool powerPressCaptured() const;
+  void endPowerPressCapture();
+};
+#include "PowerCaptureSource.inc"
+
+int main() {
+  HalGPIO gpio;
+  assert(gpio.beginPowerPressCapture() && edge == GPIO_INTR_NEGEDGE);
+  assert(!gpio.powerPressCaptured());
+  physicalPower = true;
+  handler(argument);
+  physicalPower = false;
+  assert(gpio.powerPressCaptured());  // Press and release entirely inside blocking I/O.
+  assert(gpio.powerCaptureMux.depth == 0);
+  gpio.endPowerPressCapture();
+  assert(!handler && removes == 1 && disables == 1 && gpio.capturedPowerPin == -1);
+
+  serviceResult = ESP_ERR_INVALID_STATE;
+  BoardConfig::ACTIVE.input.powerActiveHigh = true;
+  assert(gpio.beginPowerPressCapture() && edge == GPIO_INTR_POSEDGE);
+  assert(!gpio.powerPressCaptured());
+  physicalPower = true;
+  assert(gpio.powerPressCaptured());  // A held level also works before an ISR runs.
+  physicalPower = false;
+  gpio.endPowerPressCapture();
+
+  serviceResult = 9;
+  assert(!gpio.beginPowerPressCapture() && !handler);
+  serviceResult = ESP_OK;
+  edgeResult = 9;
+  assert(!gpio.beginPowerPressCapture() && !handler);
+  edgeResult = ESP_OK;
+  attachResult = 9;
+  assert(!gpio.beginPowerPressCapture() && !handler && gpio.capturedPowerPin == -1);
+  attachResult = ESP_OK;
+  BoardConfig::supported = false;
+  const int previousInstalls = installs;
+  assert(!gpio.beginPowerPressCapture() && installs == previousInstalls);
+  BoardConfig::supported = true;
+  BoardConfig::ACTIVE.input.power = -1;
+  assert(!gpio.beginPowerPressCapture() && installs == previousInstalls);
+}
