+    for (int i = 0; i < 4; ++i) bytes[at + i] = static_cast<char>(n >> (8 * i));
+  };
+  bytes[0] = 'B';
+  bytes[1] = 'M';
+  put(2, 94);
+  put(10, 62);
+  put(14, 40);
+  put(18, 8);
+  put(22, 8);
