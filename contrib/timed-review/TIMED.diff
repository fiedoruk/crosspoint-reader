+} WiFi;
+namespace pluginevents {
+enum class TimedState { NoHandler, Staged, Failure };
+struct Result {
+  TimedState state;
+  std::string asset;
+};
+static TimedState state = TimedState::Staged;
+void refreshSubscriptions() {}
