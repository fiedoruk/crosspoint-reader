+bool HalGPIO::rawPowerButtonPressed() const { return inputMgr.isPowerButtonPhysicallyPressed(); }
+
+void IRAM_ATTR HalGPIO::capturePowerPress(void* context) {
+  auto* instance = static_cast<HalGPIO*>(context);
+  portENTER_CRITICAL_ISR(&instance->powerCaptureMux);
+  instance->capturedPowerPress = true;
+  portEXIT_CRITICAL_ISR(&instance->powerCaptureMux);
+}
+
+bool HalGPIO::beginPowerPressCapture() {
+  endPowerPressCapture();
+  if (!(BoardConfig::isSticky() || BoardConfig::isX4Pro()) || BoardConfig::ACTIVE.input.power < 0) return false;
+  const bool pressed = rawPowerButtonPressed();
+  portENTER_CRITICAL(&powerCaptureMux);
+  capturedPowerPress = pressed;
+  portEXIT_CRITICAL(&powerCaptureMux);
+  const auto pin = static_cast<gpio_num_t>(BoardConfig::ACTIVE.input.power);
+  // Keep the shared service compatible with Arduino callbacks in flash.
+  const auto installed = gpio_install_isr_service(0);
+  if (installed != ESP_OK && installed != ESP_ERR_INVALID_STATE) {
+    LOG_ERR("GPIO", "Power capture service failed: %d", static_cast<int>(installed));
+    return false;
+  }
+  const auto edge = BoardConfig::ACTIVE.input.powerActiveHigh ? GPIO_INTR_POSEDGE : GPIO_INTR_NEGEDGE;
+  const auto configured = gpio_set_intr_type(pin, edge);
+  if (configured != ESP_OK) {
+    LOG_ERR("GPIO", "Power capture edge failed: %d", static_cast<int>(configured));
+    return false;
+  }
+  const auto attached = gpio_isr_handler_add(pin, capturePowerPress, this);
+  if (attached != ESP_OK) {
+    gpio_intr_disable(pin);
+    LOG_ERR("GPIO", "Power capture attach failed: %d", static_cast<int>(attached));
+    return false;
+  }
+  capturedPowerPin = static_cast<int8_t>(pin);
+  if (rawPowerButtonPressed()) {
+    portENTER_CRITICAL(&powerCaptureMux);
+    capturedPowerPress = true;
+    portEXIT_CRITICAL(&powerCaptureMux);
+  }
+  return true;
+}
+
+bool HalGPIO::powerPressCaptured() const {
+  portENTER_CRITICAL(&powerCaptureMux);
+  const bool captured = capturedPowerPress;
+  portEXIT_CRITICAL(&powerCaptureMux);
+  return captured || rawPowerButtonPressed();
+}
+
+void HalGPIO::endPowerPressCapture() {
+  if (capturedPowerPin >= 0) {
+    const auto pin = static_cast<gpio_num_t>(capturedPowerPin);
+    gpio_intr_disable(pin);
+    gpio_isr_handler_remove(pin);
+    capturedPowerPin = -1;
+  }
+  portENTER_CRITICAL(&powerCaptureMux);
+  capturedPowerPress = false;
+  portEXIT_CRITICAL(&powerCaptureMux);
 }
 
