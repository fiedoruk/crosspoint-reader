+}
+}  // namespace timedsleeppaint
+static bool syncTimerPanel();
+static uint64_t prepareTimerPanel();
+#include "TimerBootHooksSource.inc"
+#include "TimerPanelSource.inc"
+static bool runSync() {
+  gpio.beginPowerPressCapture();
+  if (timerHooks.powerPressed()) return true;
