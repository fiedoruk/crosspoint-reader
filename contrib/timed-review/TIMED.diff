+import subprocess
+import sys
+import tempfile
+
+root = Path(__file__).resolve().parents[2]
+here = Path(__file__).resolve().parent
+tls = root / 'test/plugin_verified_tls'
+sys.path.insert(0, str(tls))
+from tls_fixture import LoopbackTLS, issue, pem_cert, pem_key
+
+parser = argparse.ArgumentParser(description=__doc__)
+parser.add_argument('--wolf-root', type=Path, required=True)
+parser.add_argument('--wolf-archive', type=Path, required=True)
+parser.add_argument('--arduinojson', type=Path, required=True)
+parser.add_argument('--output', type=Path, required=True)
+args = parser.parse_args()
+flags = ['-std=c++20', '-O0', '-w', '-DFREEINK_NET_WOLFSSL=1', '-DWOLFSSL_USER_SETTINGS',
+         '-DWOLFSSL_OPTIONS_H', '-DWOLFSSL_CLIENT_EXAMPLE', '-DWOLFSSL_TLS13',
+         '-DWOLFSSL_HAVE_SP_ECC', '-DWOLFSSL_SP_SMALL', '-DHAVE_CURVE25519', '-DHAVE_SNI']
+sdk = root / 'freeink-sdk/libs/network/SecureNet'
+results = []
+with tempfile.TemporaryDirectory(prefix='timed-real-tls-') as directory:
+    temp = Path(directory)
+    command = ['nice', '-n', '10', 'c++', *flags]
+    for path in [tls/'transport_stubs', sdk/'include', args.wolf_root/'src', here/'stubs',
+                 root/'test/plugin_verified_http/stubs', root/'test/plugin_event_budget/stubs',
+                 args.arduinojson, root/'src', root/'lib/GfxRenderer', root/'lib/Memory']:
+        command += ['-I', str(path)]
+    sources = [sdk/'src/SecureClient.cpp', root/'src/util/PluginHttp.cpp', root/'src/util/PluginEvents.cpp',
+               root/'src/util/PluginEventAsset.cpp', root/'src/util/TimedSleepPaint.cpp',
+               root/'lib/GfxRenderer/Bitmap.cpp', root/'lib/GfxRenderer/BitmapHelpers.cpp', here/'RealTlsTest.cpp']
+    executable = temp/'check'
+    subprocess.run([*command, *map(str,sources), str(args.wolf_archive), '-o', str(executable)], check=True)
+    image = bytearray(94); image[:2] = b'BM'
+    for at, value in [(2,94),(10,62),(14,40),(18,8),(22,8)]: image[at:at+4] = value.to_bytes(4,'little')
+    image[26] = image[28] = 1; image[58:61] = b'\xff\xff\xff'
