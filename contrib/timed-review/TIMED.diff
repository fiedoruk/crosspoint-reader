+  GfxRenderer renderer;
+  const bool painted =
+      result.state == pluginevents::TimedState::Staged && timedsleeppaint::paint(renderer, result.asset, {});
+  Storage.remove("/sleep.bmp.part");
+  std::cout << "{\"armed_us\":" << interval << ",\"painted\":" << (painted ? "true" : "false")
+            << ",\"paints\":" << renderer.paints
+            << ",\"old_preserved\":" << (Storage.files["/sleep.bmp"] == old ? "true" : "false")
+            << ",\"private_unchanged\":"
+            << ((Storage.files["/plugins/fixture/events.jsonl"] == "private-reader-outbox" &&
+                 Storage.files["/.crosspoint/state.json"] == "private-reader-position")
+                    ? "true"
+                    : "false")
+            << "}\n";
+}
