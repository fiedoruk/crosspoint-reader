+"""Compile the production timer caller/arming path at O0 with default and lab configs."""
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+
+root = Path(__file__).resolve().parents[2]
+here = Path(__file__).resolve().parent
+sanitize = ["-fsanitize=address,undefined", "-fno-omit-frame-pointer"] if "--sanitize" in sys.argv else []
+with tempfile.TemporaryDirectory(prefix="timed-wake-guard-") as tmp:
+    for name, flags in [("default", []), ("lab", ["-DTEST_TIMER_INTERVAL_US=60000000ULL"])]:
+        binary = Path(tmp) / name
+        subprocess.run(["c++", "-std=c++20", "-O0", "-Wall", "-Wextra", "-Werror", *sanitize, *flags,
+                        "-I", str(here / "stubs"), "-I", str(root / "lib/hal"),
+                        "-I", str(root / "src"), str(here / "GuardTest.cpp"), "-o", str(binary)], check=True)
+        subprocess.run([str(binary)], check=True)
+
+# Wiring checks complement the compiled production caller. They are source
+# evidence; they do not execute Arduino setup or emulate the physical panel.
+main = (root / "src/main.cpp").read_text()
+setup = main[main.index("void setup() {"):main.index("void loop() {")]
+route = setup.index("timedwake::handleBoot(")
+for later in ["Storage.begin()", "APP_STATE.loadFromFile()", "Frontlight.begin(", "setupDisplayAndFonts("]:
+    assert route < setup.index(later), later
+hooks = setup[setup.index("struct TimerBootHooks"):route]
+for forbidden in ["APP_STATE", "renderer.", "WiFi."]:
+    # Comments may explain the absence of APP_STATE writes.
+    code = "\n".join(line for line in hooks.splitlines() if not line.lstrip().startswith("//"))
+    assert forbidden not in code, forbidden
+assert "prepareTimerPanel()" in hooks
+assert "syncTimerPanel()" in hooks
+assert "powerManager.startDeepSleep(gpio, intervalUs, true)" in hooks
+assert "powerManager.startDeepSleep(gpio);" in main
+hal = (root / "lib/hal/HalPowerManager.cpp").read_text()
+assert "timerwakearm::sleep(fromTimerWake)" in hal
+assert "freeink::PowerManager::powerDownRailsForSleep()" in hal
+assert "freeink::m5pm1::requestShutdown()" in hal
+assert "freeink::metalio::powerOff()" in hal
+assert "BoardConfig::isSticky() || BoardConfig::isX4Pro()" in main
+assert "keepX4PoweredForTimer" in hal  # Preserve the timer primitive's C3 policy.
+assert "takeAbortedSleepInfo" not in main + hal
+print("Timer guard main/HAL wiring checks passed (SOURCE only)")
