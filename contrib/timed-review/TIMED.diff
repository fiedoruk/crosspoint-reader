+    ca_path = temp/'root.pem'; ca_path.write_bytes(pem_cert(ca))
+    for name, san, body, status, expected in [
+        ('delivered', 'good.test', bytes(image), 200, True),
+        ('invalid-bmp', 'good.test', b'bad BMP', 200, False),
+        ('revoked', 'good.test', b'revoked', 401, False),
