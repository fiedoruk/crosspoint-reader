+  void deepSleep() { trace.push_back("TILT_SLEEP"); }
+} halTiltSensor;
+struct Esp {
+  void restart() { throw Restarted{}; }
+} ESP;
+struct Clock {
+  void begin() {}
+} halClock;
+namespace trustedtime {
+void init() {}
+bool clockReady = true;
+int syncStarts = 0;
+uint32_t clockElapsedMs = 0;
+bool fresh = false;
+bool syncFresh(uint32_t timeout, const std::function<bool()>& abort) {
+  ++syncStarts;
+  fresh = false;
+  if (abort()) return false;
+  if (!clockReady) {
+    while (timeout && !abort()) {
+      delay(50);
+      timeout -= 50;
+    }
+    return false;
+  }
+  delay(clockElapsedMs);
+  fresh = !abort();
+  return fresh;
+}
+bool hasFreshSync() { return fresh; }
+}  // namespace trustedtime
