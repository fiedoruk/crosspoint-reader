+  pluginevents::DrainBudget budget(4, 15000, &millis);
+  return pluginevents::timedSync(budget, abort);
+}
+static pluginevents::TimedResult runTimed(int width, int height, const std::function<bool()>& abort) {
+  pluginevents::prepareTimed(width, height);
+  return consumeTimed(abort);
