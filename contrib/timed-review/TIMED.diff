+#pragma once
+
+#include <Logging.h>
+#include <PowerManager.h>
+#include <esp_sleep.h>
+#include <esp_system.h>
+
+#include <cstdint>
+
+namespace timerwakearm {
+// Wake sources survive wakeup; zero must explicitly restore button-only sleep.
+inline void clearTimer() {
+  const auto disabled = esp_sleep_disable_wakeup_source(ESP_SLEEP_WAKEUP_TIMER);
+  if (disabled != ESP_OK && disabled != ESP_ERR_INVALID_STATE) {
+    // Do not sleep with a wake source whose state could not be cleared.
+    LOG_ERR("PWR", "Timer wake disable failed: %d; restarting", static_cast<int>(disabled));
+    esp_restart();
+  }
+}
+
+// Rejected timer requests fall back to button-only sleep.
+inline bool arm(const uint64_t intervalUs) {
+  if (intervalUs == 0) {
+    clearTimer();
+    return false;
+  }
+  const auto result = esp_sleep_enable_timer_wakeup(intervalUs);
+  if (result == ESP_OK) return true;
+  LOG_ERR("PWR", "Timer wake arming failed: %d", static_cast<int>(result));
+  clearTimer();
+  return false;
+}
+inline void sleep(const bool fromTimerWake) {
+  if (fromTimerWake) {
+    // A button arriving during timer teardown must wake us, not be consumed by
+    // waitForPowerButtonRelease(). A sleep abort restarts through the SDK.
+    freeink::PowerManager::armPowerButtonWakeup();
+    freeink::PowerManager::deepSleep();
+  } else {
+    freeink::PowerManager::deepSleepUntilPowerButton();
+  }
+}
+}  // namespace timerwakearm
