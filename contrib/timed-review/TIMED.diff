+  Storage.files["/plugins/fixture/token.json"] = R"({"token":"TEST-ONLY-TOKEN"})";
+  Storage.files["/plugins/fixture/device.json"] =
+      std::string(
+          R"({"token":{"file":"token.json"},"events":{"sleep.timer":{"interval_seconds":60,"download":{"url":"https://good.test:)") +
+      argv[1] +
+      R"(/frame","headers":{"Authorization":"Bearer {token}"},"dest":"/sleep.bmp","format":"bmp","width":8,"height":8,"tls":{"ca_file":"ca.pem"}}}}})";
+  Storage.files["/plugins/fixture/events.jsonl"] = "private-reader-outbox";
+  Storage.files["/.crosspoint/state.json"] = "private-reader-position";
+  pluginevents::refreshSubscriptions();
+  const auto interval = pluginevents::prepareTimed(8, 8);
+  pluginevents::DrainBudget budget(4, 15000, []() -> uint32_t { return millis(); });
