+#include <Arduino.h>
+#include <TrustedTime.h>
+#include <esp_sntp.h>
+#include <sys/time.h>
+#include <time.h>
+
+#include <cassert>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+
+int64_t testPersistedFloor = 0;
+static int64_t now = 1800000000;
+static uint32_t ms = 0;
+static uint32_t callbackAfter = UINT32_MAX;
+static int64_t callbackValue = 0;
+static void (*callback)(timeval*) = nullptr;
+static std::string lastTz;
+static int configs = 0;
+static int status = SNTP_SYNC_STATUS_COMPLETED;
+extern "C" time_t time(time_t* out) {
+  if (out) *out = static_cast<time_t>(now);
+  return static_cast<time_t>(now);
+}
+extern "C" int settimeofday(const timeval* tv, const struct timezone*) {
+  now = tv->tv_sec;
+  return 0;
+}
+uint32_t millis() { return ms; }
+void delay(uint32_t n) {
+  ms += n;
+  if (callbackAfter != UINT32_MAX && static_cast<uint32_t>(ms - callbackAfter) < 1000) {
+    now = callbackValue;
+    callbackAfter = UINT32_MAX;
+    timeval tv{};
+    callback(&tv);
+  }
+}
+void configTzTime(const char* tz, const char*) {
+  lastTz = tz;
+  ++configs;
+}
+void sntp_set_time_sync_notification_cb(void (*cb)(timeval*)) { callback = cb; }
+bool esp_sntp_enabled() { return false; }
+int sntp_get_sync_status() { return status; }
+static void schedule(uint32_t wait, int64_t epoch) {
+  callbackAfter = ms + wait;
+  callbackValue = epoch;
+}
+int main() {
+  setenv("TZ", "CET-1CEST", 1);
+  trustedtime::init();
+  assert(callback);
+  assert(!trustedtime::hasFreshSync());
+  // A stale COMPLETED status and plausible saved time do not prove a new sync.
+  assert(!trustedtime::syncFresh(100));
+  assert(!trustedtime::hasFreshSync() && configs == 1 && lastTz == "CET-1CEST");
+  schedule(50, 1800000100);
+  assert(trustedtime::syncFresh(1000));
+  assert(trustedtime::hasFreshSync());
+  // Direct verified calls may use this proof briefly, but a new failed
+  // cycle invalidates it even when abort happens before SNTP restarts.
+  const int preAbortConfigs = configs;
+  assert(!trustedtime::syncFresh(1000, [] { return true; }));
+  assert(configs == preAbortConfigs && !trustedtime::hasFreshSync());
+  assert(!trustedtime::syncFresh(0));
+  assert(!trustedtime::hasFreshSync());
+  schedule(50, 1800000100);
+  assert(trustedtime::syncFresh(1000));
+  assert(testPersistedFloor >= 1800000100);
+  // The existing APIs continue to accept a floor and a stale global status.
+  assert(trustedtime::trustedNow() >= 1800000100);
+  assert(trustedtime::syncNow(100));
+  trustedtime::note();
+  // New callback below a previously observed floor must fail, without rollback.
+  schedule(50, 1800000000);
+  assert(!trustedtime::syncFresh(1000));
+  assert(!trustedtime::hasFreshSync());
+  assert(trustedtime::trustedNow() >= 1800000100);
+  now = 1800000200;
+  testPersistedFloor = 1900000000;
+  schedule(50, 1800000300);
+  assert(!trustedtime::syncFresh(1000));
+  assert(!trustedtime::hasFreshSync());
+  // Abort both before configure and after the callback. No proof survives.
+  const int oldConfigs = configs;
+  assert(!trustedtime::syncFresh(1000, [] { return true; }));
+  assert(configs == oldConfigs);
+  testPersistedFloor = 1800000100;
+  now = 1800000300;
+  schedule(50, 1800000400);
+  assert(!trustedtime::syncFresh(1000, [] { return callbackAfter == UINT32_MAX; }));
+  assert(!trustedtime::hasFreshSync());
+  // SNTP may wait nearly five seconds before its first request. A later
+  // callback still proves this attempt, but the wait remains bounded.
+  schedule(7000, 1800000450);
+  assert(trustedtime::syncFresh(10000));
+  assert(trustedtime::hasFreshSync());
+  const uint32_t timeoutStarted = ms;
+  assert(!trustedtime::syncFresh(10000));
+  assert(ms - timeoutStarted == 10000 && !trustedtime::hasFreshSync());
+  // Wrap-safe bounded wait and proof age.
+  ms = UINT32_MAX - 20;
+  schedule(50, 1800000500);
+  assert(trustedtime::syncFresh(200));
+  assert(trustedtime::hasFreshSync());
+  ms += 30000;
+  assert(!trustedtime::hasFreshSync());
+  schedule(50, 1800000600);
+  assert(trustedtime::syncFresh(200));
+  assert(trustedtime::hasFreshSync());
+  // Model a full millis() revolution plus 10 ms: modulo age looks recent,
+  // while the wall clock advanced by over 49 days.
+  ms += 10;
+  now += 4294968;
+  assert(!trustedtime::hasFreshSync());
+  schedule(50, 1800000700);
+  assert(trustedtime::syncFresh(200));
+  now += 31;
+  assert(!trustedtime::hasFreshSync());
+  assert(lastTz == "CET-1CEST");
+}
