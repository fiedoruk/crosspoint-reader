+                     args.arduinojson, root / "src", root / "lib/GfxRenderer", root / "lib/Memory"]:
+            command += ["-I", str(path)]
+        command += [str(source), str(root / "src/util/PluginHttp.cpp"),
+                    str(root / "src/util/PluginEventAsset.cpp"), str(root / "lib/GfxRenderer/Bitmap.cpp"),
+                    str(root / "lib/GfxRenderer/BitmapHelpers.cpp"), str(here / "NativeHttpTest.cpp")]
+        if variant != "backend-disabled": command += [str(args.wolf_archive)]
