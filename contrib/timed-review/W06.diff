+bool loadPluginCa(const pluginhttp::VerifiedTrust& trust, std::string& caPem) {
+  // The trust anchor must be a file beneath this plugin, never an absolute
+  // manifest path or another plugin's private file.
+  const std::string& rel = trust.caFile;
+  if (trust.pluginDir.empty() || rel.empty() || rel.size() > 128 || rel.front() == '/' || rel.back() == '/' ||
+      rel.find("..") != std::string::npos || rel.find("//") != std::string::npos || rel.find('\\') != std::string::npos)
+    return false;
+  const std::string path = trust.pluginDir + "/" + rel;
+  if (!protectedpaths::isPluginPath(path)) return false;
+  if (!Storage.readFileToString("PHTP", path, MAX_CA_FILE_SIZE, caPem)) return false;
+  // The SDK parses the PEM; this precheck catches empty/truncated and binary
+  // files before any socket is opened.
+  const size_t begin = caPem.find("-----BEGIN CERTIFICATE-----");
+  const size_t end = caPem.find("-----END CERTIFICATE-----", begin == std::string::npos ? 0 : begin + 27);
+  return caPem.size() >= 64 && caPem.find('\0') == std::string::npos && begin != std::string::npos &&
+         end != std::string::npos;
