+  using DataCallback = std::function<bool(const uint8_t*, size_t)>;
+  using AbortCallback = std::function<bool()>;
+  struct Reply {
+    int status;
+    std::string body;
+    bool complete = true;
+  };
+  static inline int begins = 0, insecureCalls = 0, caCalls = 0, sends = 0;
+  static inline int status = 200;
+  static inline std::string reply;
+  static inline bool complete = true;
+  static inline std::vector<Reply> replies;
+  static inline uint32_t sendDelayMs = 0;
+  static inline bool abortAfterBody = false;
+  static inline std::vector<std::string> urls, headers, bodies;
+  const char* ca = nullptr;
+  void setUserAgent(const char*) {}
+  void setInsecure() { ++insecureCalls; }
+  void setCACert(const char* value) {
+    ca = value;
+    ++caCalls;
+  }
+  void setTimeout(uint32_t) {}
+  void setFollowRedirects(int hops) { assert(hops == 0); }
+  bool begin(const std::string& url) {
+    ++begins;
+    urls.push_back(url);
+    return true;
+  }
+  void addHeader(const std::string& name, const std::string& value) { headers.push_back(name + ":" + value); }
+  int sendRequest(const char*, const uint8_t* body, size_t length, const DataCallback& onData,
+                  const AbortCallback& abort = nullptr) {
+    if (abort && abort()) return -1;
+    if (ca) assert(std::string(ca).find("-----BEGIN CERTIFICATE-----") != std::string::npos);
+    bodies.emplace_back(reinterpret_cast<const char*>(body), length);
+    ++sends;
+    trustedtime::fixtureMs += sendDelayMs;
+    if (!replies.empty()) {
+      auto r = replies.front();
+      replies.erase(replies.begin());
+      status = r.status;
+      reply = r.body;
+      complete = r.complete;
+    }
+    if (!reply.empty() && !onData(reinterpret_cast<const uint8_t*>(reply.data()), reply.size())) complete = false;
+    if (abortAfterBody && abort && abort()) return -1;
+    return status;
+  }
+  bool responseComplete() const { return complete; }
+  std::vector<std::pair<std::string, std::string>> getHeaders() const { return {}; }
+};
