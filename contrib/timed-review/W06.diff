+// The SDK ends the authority only at '/'; query/userinfo must not become a logged host.
+bool validVerifiedUrl(const std::string& url) {
+  if (url.compare(0, 8, "https://") != 0 || url.size() == 8 || url[8] == ':') return false;
+  if (std::any_of(url.begin(), url.end(), [](unsigned char c) { return c <= 0x20 || c == 0x7f || c == '\\'; }))
