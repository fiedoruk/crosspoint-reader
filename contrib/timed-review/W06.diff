+    for (size_t i = 0; i < 4; ++i) s[at + i] = static_cast<char>(value >> (i * 8));
+  };
+  le16(0, 0x4d42);
+  le32(2, 70);
+  le32(10, 54);
+  le32(14, 40);
+  le32(18, 2);
+  le32(22, 2);
+  le16(26, 1);
+  le16(28, 24);
+  le32(34, 16);
