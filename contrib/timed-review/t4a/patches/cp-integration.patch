index 0000000..fab2f7a
--- /dev/null
+++ b/test/timed_sync/TimedSyncTest.cpp
@@ -0,0 +1,297 @@
+#include <HalStorage.h>
+#include <SecureHttpClient.h>
+#include <TrustedTime.h>
+
+#include <cassert>
+#include <string>
+#include <vector>
+
+#include "util/PluginDrainBudget.h"
+#include "util/PluginEvents.h"
+#include "util/PluginLocations.h"
+uint32_t millis() { return freeink::fakeNow; }
+namespace PluginLocations {
+std::vector<Entry> entries;
+std::vector<Entry> scanPlugins() { return entries; }
+std::string findPluginDir(const char*) { return {}; }
+}  // namespace PluginLocations
+static const std::string history = R"({"e":"reader.session","vars":{"book":"private.epub"}})"
+                                   "\n";
+static const std::string manifest =
+    R"({"token":{"file":"token.json"},"events":{"sleep.timer":{"interval_seconds":60,"download":{"url":"https://fixture.invalid/{cfg.slot}?token={token}&id={event.id}","dest":"/sleep.bmp","format":"bmp","width":8,"height":8,"tls":{"ca_file":"ca.pem"}},"toast":"must never appear"},"reader.session":{"request":{"url":"https://fixture.invalid/history"}}},"config":{"file":"config.json"}})";
+static std::string bmp() {
+  std::string bytes(94, '\0');
+  auto put = [&](int at, unsigned n) {
+    for (int i = 0; i < 4; ++i) bytes[at + i] = static_cast<char>(n >> (8 * i));
+  };
+  bytes[0] = 'B';
+  bytes[1] = 'M';
+  put(2, 94);
+  put(10, 62);
+  put(14, 40);
+  put(18, 8);
+  put(22, 8);
+  bytes[26] = 1;
+  bytes[28] = 1;
+  bytes[58] = bytes[59] = bytes[60] = static_cast<char>(255);
+  return bytes;
+}
+static void setup(std::string mf = manifest) {
+  Storage = StorageStub{};
+  PluginLocations::entries = {{"fixture", "/plugins/fixture", false, true, false}};
+  Storage.files["/plugins/fixture/device.json"] = mf;
+  Storage.files["/plugins/fixture/events.jsonl"] = history;
+  Storage.files["/plugins/fixture/token.json"] = R"({"token":"fixture-token"})";
+  Storage.files["/plugins/fixture/config.json"] = R"({"slot":"frame"})";
+  Storage.files["/plugins/fixture/ca.pem"] =
+      "-----BEGIN CERTIFICATE-----\nfixture-not-a-real-certificate-pad\n-----END CERTIFICATE-----";
+  Storage.files["/sleep.bmp"] = bmp();
+  freeink::fakeNow = 0;
+  trustedtime::now = 1800000000;
+  trustedtime::systemNow = trustedtime::now;
+  trustedtime::fresh = true;  // main's fresh clock attempt precedes timedSync.
+  auto& replies = freeink::SecureHttpClient::replies;
+  replies = {{200, bmp(), 0}};
+  freeink::SecureHttpClient::sends = 0;
+  freeink::SecureHttpClient::insecureCalls = 0;
+  freeink::SecureHttpClient::caCalls = 0;
+  freeink::SecureHttpClient::aborted = false;
+  freeink::SecureHttpClient::beginOk = true;
+  pluginevents::refreshSubscriptions();
+}
+static pluginevents::TimedResult consumeTimed(const std::function<bool()>& abort) {
+  pluginevents::DrainBudget budget(4, 15000, &millis);
+  return pluginevents::timedSync(budget, abort);
+}
+static pluginevents::TimedResult runTimed(int width, int height, const std::function<bool()>& abort) {
+  pluginevents::prepareTimed(width, height);
+  return consumeTimed(abort);
+}
+int main() {
+  using S = pluginevents::TimedState;
+  using HTTP = freeink::SecureHttpClient;
+  setup();
+#if TEST_PEER_VERIFICATION_AVAILABLE
+  assert((pluginevents::prepareTimed(8, 8) != 0));
+#else
+  assert(!(pluginevents::prepareTimed(8, 8) != 0));
+#endif
+  const auto old = Storage.files["/sleep.bmp"];
+#if !TEST_PEER_VERIFICATION_AVAILABLE
+  assert(runTimed(8, 8, {}).state == S::Failure);
+  assert(HTTP::sends == 0 && HTTP::insecureCalls == 0);
+  assert(Storage.files["/sleep.bmp"] == old);
+#else
+  // W08 preserves the installed root; each timer cycle reads its current config.
+  for (const char* root : PluginLocations::ROOTS) {
+    setup();
+    const std::string installed = std::string(root) + "/fixture";
+    auto files = Storage.files;
+    for (const auto& item : files) {
+      const std::string prefix = "/plugins/fixture";
+      if (item.first.compare(0, prefix.size(), prefix) == 0) {
+        Storage.files.erase(item.first);
+        Storage.files[installed + item.first.substr(prefix.size())] = item.second;
+      }
+    }
+    PluginLocations::entries = {{"fixture", installed, false, true, false}};
+    pluginevents::refreshSubscriptions();
+    assert(pluginevents::prepareTimed(8, 8) == 60000000ULL);
+    assert(consumeTimed({}).state == S::Staged);
+    Storage.files[installed + "/config.json"] = R"({"slot":"updated-frame"})";
+    HTTP::replies.push_back({200, bmp(), 0});
+    assert(pluginevents::prepareTimed(8, 8) == 60000000ULL);
+    assert(consumeTimed({}).state == S::Staged);
+    assert(HTTP::lastUrl.find("/updated-frame?token=fixture-token&") != std::string::npos);
+    assert(Storage.files[installed + "/events.jsonl"] == history);
+    Storage.files.erase(installed + "/device.json");
+    pluginevents::refreshSubscriptions();
+    assert(pluginevents::prepareTimed(8, 8) == 0);
+  }
+  setup();
+  auto result = runTimed(8, 8, {});
+  assert(result.state == S::Staged && result.asset == "/sleep.bmp");
+  assert(Storage.files["/sleep.bmp"] == old);
+  assert(Storage.files["/sleep.bmp.part"] == bmp());
+  assert(HTTP::sends == 1 && HTTP::caCalls == 1 && HTTP::insecureCalls == 0);
+  assert(HTTP::lastUrl.find("/frame?token=fixture-token&id=") != std::string::npos);
+  assert(HTTP::lastUrl.find("private.epub") == std::string::npos);
+  assert(Storage.files["/plugins/fixture/events.jsonl"] == history);
+  for (int status : {204, 304, 401, 403, 500, -1}) {
+    setup();
+    HTTP::replies = {{status, "", 0}};
+    assert(runTimed(8, 8, {}).state == S::Failure);
+    assert(Storage.files["/sleep.bmp"] == old && HTTP::insecureCalls == 0);
+  }
+  setup();
+  HTTP::replies = {{200, "malformed BMP", 0}};
+  assert(runTimed(8, 8, {}).state == S::Failure);
+  assert(Storage.files["/sleep.bmp"] == old);
+  setup();
+  Storage.failWrite = true;
+  assert(runTimed(8, 8, {}).state == S::Failure);
+  assert(Storage.files["/sleep.bmp"] == old);
+  setup();
+  HTTP::beginOk = false;
+  assert(runTimed(8, 8, {}).state == S::Failure);
+  assert(HTTP::sends == 0);
+  setup();
+  trustedtime::now = 0;
+  assert(runTimed(8, 8, {}).state == S::Failure);
+  assert(HTTP::sends == 0);
+  setup();
+  Storage.files.erase("/plugins/fixture/token.json");
+  assert(runTimed(8, 8, {}).state == S::Failure);
+  assert(HTTP::sends == 0);
+  setup();
+  Storage.files["/plugins/fixture/token.json"] = R"({"token":""})";
+  assert(runTimed(8, 8, {}).state == S::Failure);
+  assert(HTTP::sends == 0 && Storage.files["/sleep.bmp"] == old);
+  assert(Storage.files["/plugins/fixture/events.jsonl"] == history);
+  std::string tokenless = manifest;
+  const std::string tokenDeclaration = R"("token":{"file":"token.json"},)";
+  const auto tokenPosition = tokenless.find(tokenDeclaration);
+  assert(tokenPosition != std::string::npos);
+  tokenless.erase(tokenPosition, tokenDeclaration.size());
+  setup(tokenless);
+  assert(runTimed(8, 8, {}).state == S::Failure);
+  assert(HTTP::sends == 0 && Storage.files["/sleep.bmp"] == old);
+  assert(Storage.files["/plugins/fixture/events.jsonl"] == history);
+  setup();
+  Storage.files.erase("/plugins/fixture/ca.pem");
+  assert(runTimed(8, 8, {}).state == S::Failure);
+  assert(HTTP::sends == 0);
+  setup();
+  HTTP::replies = {{200, bmp(), 16000}};
+  assert(runTimed(8, 8, {}).state == S::Failure);
+  assert(Storage.files["/sleep.bmp"] == old);
+  // Verified password refresh reuses one shared budget; insecure auth is never called.
+  const std::string verifiedGrant =
+      R"({"type":"password","request":{"url":"https://fixture.invalid/auth","tls":{"ca_file":"ca.pem"}}})";
+  setup(std::string("{\"auth\":") + verifiedGrant + "," + manifest.substr(1));
+  HTTP::replies = {{401, "", 0}, {200, R"({"access_token":"new-fixture-token"})", 0}, {200, bmp(), 0}};
+  assert(runTimed(8, 8, {}).state == S::Staged);
+  assert(HTTP::sends == 3 && HTTP::insecureCalls == 0);
+  assert(Storage.files["/plugins/fixture/token.json"].find("new-fixture-token") != std::string::npos);
+  // A clock wait has already consumed 5s of the same 15s window. An auth
+  // response reaching its deadline cannot start the image retry.
+  setup(std::string("{\"auth\":") + verifiedGrant + "," + manifest.substr(1));
+  HTTP::replies = {{401, "", 2000}, {200, R"({"access_token":"late-token"})", 8000}, {200, bmp(), 0}};
+  pluginevents::prepareTimed(8, 8);
+  pluginevents::DrainBudget shared(4, 15000, &millis);
+  freeink::fakeNow += 5000;
+  assert(pluginevents::timedSync(shared, {}).state == S::Failure);
+  assert(HTTP::sends == 2 && Storage.files["/sleep.bmp"] == old);
+  assert(Storage.files["/plugins/fixture/events.jsonl"] == history);
+  setup(std::string("{\"auth\":") + R"({"type":"password","request":{"url":"https://fixture.invalid/auth"}})" + "," +
+        manifest.substr(1));
+  HTTP::replies = {{401, "", 0}, {200, R"({"access_token":"forbidden"})", 0}};
+  assert(runTimed(8, 8, {}).state == S::Failure);
+  assert(HTTP::sends == 1 && HTTP::insecureCalls == 0);
+  // Snapshot URL/grant/config together; no mixed configuration during clock wait.
+  setup();
+  assert(pluginevents::prepareTimed(8, 8) == 60000000ULL);
+  const auto reads = Storage.reads["/plugins/fixture/device.json"];
+  Storage.files["/plugins/fixture/token.json"] = R"({"token":"other-grant"})";
+  Storage.files["/plugins/fixture/config.json"] = R"({"slot":"other-frame"})";
+  Storage.files["/plugins/fixture/device.json"] = "{}";
+  assert(consumeTimed({}).state == S::Staged);
+  assert(HTTP::lastUrl.find("/frame?token=fixture-token&") != std::string::npos);
+  assert(Storage.reads["/plugins/fixture/device.json"] == reads);
+  assert(consumeTimed({}).state == S::NoHandler && HTTP::sends == 1);
+  pluginevents::refreshSubscriptions();
+  assert(pluginevents::prepareTimed(8, 8) == 0);  // Disabled next cycle.
+  assert(consumeTimed({}).state == S::NoHandler);
+  setup();
+  assert(pluginevents::prepareTimed(8, 8));
+  pluginevents::discardTimed();
+  assert(consumeTimed({}).state == S::NoHandler && HTTP::sends == 0);
+  setup();
+  assert(pluginevents::prepareTimed(8, 8));
+  assert(consumeTimed([] { return true; }).state == S::Failure);
+  assert(consumeTimed({}).state == S::NoHandler && HTTP::sends == 0);
+  setup();
+  Storage.files["/plugins/fixture/ca.pem"] = "not a PEM";
+  assert(pluginevents::prepareTimed(8, 8) == 0 && HTTP::sends == 0);
+  setup();
+  Storage.files.erase("/plugins/fixture/device.json");
+  pluginevents::refreshSubscriptions();
+  assert(pluginevents::prepareTimed(8, 8) == 0);
+  for (const auto& value : {"0", "false", "true", "-1", "59", "86401", "60.0", "\"60\"", "null", "4294967296"}) {
+    std::string invalid = manifest;
+    const auto at = invalid.find("\"interval_seconds\":60,");
+    invalid.replace(at, std::string("\"interval_seconds\":60,").size(),
+                    std::string("\"interval_seconds\":") + value + ",");
+    setup(invalid);
+    assert(pluginevents::prepareTimed(8, 8) == 0 && HTTP::sends == 0);
+  }
+  std::string missingCadence = manifest;
+  const auto cadenceAt = missingCadence.find("\"interval_seconds\":60,");
+  missingCadence.erase(cadenceAt, std::string("\"interval_seconds\":60,").size());
+  setup(missingCadence);
+  assert(pluginevents::prepareTimed(8, 8) == 0);
+  std::string maximumCadence = manifest;
+  maximumCadence.replace(maximumCadence.find("\"interval_seconds\":60,"),
+                         std::string("\"interval_seconds\":60,").size(), "\"interval_seconds\":86400,");
+  setup(maximumCadence);
+  assert(pluginevents::prepareTimed(8, 8) == 86400000000ULL);
+  // Ignored discovery entries cannot conceal a second timer declaration.
+  for (const auto& bad : {std::string("{"), std::string(8193, 'x')}) {
+    setup();
+    PluginLocations::entries.push_back({"broken", "/plugins/broken", false, true, false});
+    Storage.files["/plugins/broken/device.json"] = bad;
+    pluginevents::refreshSubscriptions();
+    assert(pluginevents::prepareTimed(8, 8) == 0);
+    assert(pluginevents::anySubscriber(pluginevents::Event::ReaderSession));
+  }
+  setup();
+  PluginLocations::entries.push_back({std::string(24, 'x'), "/plugins/long", false, true, false});
+  pluginevents::refreshSubscriptions();
+  assert(pluginevents::prepareTimed(8, 8) == 0);
+  setup();
+  for (int i = 0; i < 8; ++i) {
+    const std::string name = "extra" + std::to_string(i), dir = "/plugins/" + name;
+    PluginLocations::entries.push_back({name, dir, false, true, false});
+    Storage.files[dir + "/device.json"] = R"({"events":{"reader.session":{}}})";
+  }
+  pluginevents::refreshSubscriptions();
+  assert(pluginevents::prepareTimed(8, 8) == 0);
+  setup();
+  bool manual = false;
+  HTTP::replies = {{200, bmp(), 10}};
+  assert(runTimed(8, 8, [&] { return manual || freeink::fakeNow > 0; }).state == S::Failure);
+  assert(Storage.files["/sleep.bmp"] == old);
+#endif
+  setup();
+  auto before = Storage.files["/plugins/fixture/events.jsonl"];
+  pluginevents::emit(pluginevents::Event::SleepTimer, nullptr, 0);
+  assert(Storage.files["/plugins/fixture/events.jsonl"] == before);
+  Storage.files["/plugins/fixture/events.jsonl"] = R"({"e":"sleep.timer","vars":{}})"
+                                                   "\n";
+  pluginevents::drain(nullptr, 4);
+  assert(HTTP::sends == 0);
+  assert(!Storage.exists("/plugins/fixture/events.jsonl"));
+  setup("{}");
+  assert(!(pluginevents::prepareTimed(8, 8) != 0));
+  assert(runTimed(8, 8, {}).state == S::NoHandler);
+  setup();
+  assert(!(pluginevents::prepareTimed(9, 8) != 0));
+  assert(runTimed(9, 8, {}).state == S::Failure);
+  assert(HTTP::sends == 0);
+  setup();
+  PluginLocations::entries.push_back({"second", "/plugins/second", false, true, false});
+  Storage.files["/plugins/second/device.json"] = manifest;
+  pluginevents::refreshSubscriptions();
+  assert(!(pluginevents::prepareTimed(8, 8) != 0));
+  assert(runTimed(8, 8, {}).state == S::Failure);
+  assert(HTTP::sends == 0);
+  setup();
+  std::string insecure = manifest;
+  const auto tls = insecure.find(",\"tls\":{\"ca_file\":\"ca.pem\"}");
+  assert(tls != std::string::npos);
+  insecure.erase(tls, std::string(",\"tls\":{\"ca_file\":\"ca.pem\"}").size());
+  setup(insecure);
+  assert(!(pluginevents::prepareTimed(8, 8) != 0));
+  assert(runTimed(8, 8, {}).state == S::Failure);
+  assert(HTTP::sends == 0);
+}
