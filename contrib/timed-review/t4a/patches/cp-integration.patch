@@ -0,0 +1,58 @@
+// Actual CP PluginHttp and SDK TLS; only clock, radio and storage are host boundaries.
+#include <HalStorage.h>
+#include <SecureHttpClient.h>
+#include <TrustedTime.h>
+
+#undef time
+#include <ctime>
+#include <fstream>
+#include <iostream>
+#include <iterator>
+#include <string>
+
+#include "util/PluginEventAsset.h"
+#include "util/PluginHttp.h"
+
+static std::string read(const char* path) {
+  std::ifstream input(path, std::ios::binary);
+  return {std::istreambuf_iterator<char>(input), std::istreambuf_iterator<char>()};
+}
+
+int main(int argc, char** argv) {
+  if (argc != 7) return 2;
+  const std::string mode = argv[1];
+  const std::string url = "https://" + std::string(argv[2]) + ":" + argv[3] + "/frame";
+  const std::string ca = read(argv[4]);
+  const std::string frame = read(argv[5]);
+  const auto now = static_cast<int64_t>(std::time(nullptr));
+  trustedtime::now = trustedtime::systemNow = now;
+  trustedtime::fresh = std::string(argv[6]) == "fresh";
+  Storage.files["/plugins/test/root.pem"] = ca;
+  std::string old = frame;
+  if (!old.empty()) old.back() ^= 0x55;
+  Storage.files["/sleep.bmp"] = old;
+  const pluginhttp::VerifiedTrust trust{"/plugins/test", "root.pem"};
+  const auto* selectedTrust = mode == "legacy" ? nullptr : &trust;
+  const pluginhttp::Headers headers{{"Authorization", "Bearer TEST-ONLY-TOKEN"}};
+  int status = -1;
+  bool committed = false, minted = false;
+  if (mode == "download") {
+    status =
+        pluginhttp::requestToFile(nullptr, url, "GET", "", headers, "/sleep.bmp.part", 1024 * 1024, {}, selectedTrust);
+    committed = plugineventasset::commit("/sleep.bmp", 8, 8, status);
+    if (!committed) Storage.remove("/sleep.bmp.part");
+  } else if (mode == "auth") {
+    std::string token;
+    minted = pluginhttp::mintPasswordToken(nullptr, url, "POST", "grant_type=fixture", headers, "access_token", token,
+                                           {}, selectedTrust);
+    minted = minted && token == "fixture-issued";
+    status = minted ? 200 : -1;
+  } else {
+    String response;
+    status = pluginhttp::request(nullptr, url, "GET", "", headers, response, 1024, nullptr, {}, selectedTrust);
+  }
+  std::cout << "{\"capability\":" << (pluginhttp::peerVerificationAvailable() ? "true" : "false")
+            << ",\"status\":" << status << ",\"committed\":" << (committed ? "true" : "false")
+            << ",\"old_preserved\":" << (Storage.files["/sleep.bmp"] == old ? "true" : "false")
+            << ",\"minted\":" << (minted ? "true" : "false") << "}\n";
+}
