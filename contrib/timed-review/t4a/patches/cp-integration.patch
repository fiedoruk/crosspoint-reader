+"""Regression for early Local wake without loading or saving reader state."""
+from pathlib import Path
+import subprocess, tempfile, sys
+root = Path(__file__).resolve().parents[2]
+here = Path(__file__).resolve().parent
+source = Path(sys.argv[1]).read_text() if len(sys.argv) > 1 else (root / 'src/activities/boot_sleep/SleepActivity.cpp').read_text()
+def between(start, end):
+    a = source.index(start)
+    return source[a:source.index(end, a)]
+selection = between('enum class SleepRecentKind', 'bool findNextValidSleepImage')
+selection += '''bool findNextValidSleepImage(HalFile& dir, SleepRecentKind, char* name) {
+  if (dir.entry++) return false;
+  std::strcpy(name, "image.bmp"); return true;
+}\n'''
+selection += between('bool selectRandomSleepFile', 'bool drawSleepPopupPreservingFrame')
+rendering = between('bool SleepActivity::renderTimedSleepScreen', 'void SleepActivity::renderCustomSleepScreen')
+legacy = 'void SleepActivity::renderBitmapSleepScreen' in source
+rendering += between(('void' if legacy else 'bool') + ' SleepActivity::renderBitmapSleepScreen', 'bool SleepActivity::renderSleepOverlayFile')
+with tempfile.TemporaryDirectory(prefix='timed-local-') as tmp:
+    p = Path(tmp)
+    (p/'Selection.inc').write_text(selection)
+    (p/'Rendering.inc').write_text(rendering)
+    subprocess.run(['c++','-std=c++20','-O0','-Wall','-Wextra','-fsanitize=address,undefined', *(['-DLEGACY_VOID'] if legacy else []),'-I',tmp,
+                    str(here/'LocalTest.cpp'),'-o',str(p/'test')], check=True)
+    subprocess.run([str(p/'test')], check=True)
+print('Local actual selection/render methods: state preservation, decode failure, missing/header, gray fallback, normal history PASS')
+print('SD iteration/Bitmap/Gfx are boundaries; no full boot or physical-panel claim')
