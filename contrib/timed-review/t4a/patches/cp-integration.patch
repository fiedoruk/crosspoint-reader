index 0000000..ea93d56
--- /dev/null
+++ b/test/timer_plugin_permission/PermissionTest.cpp
@@ -0,0 +1,151 @@
+#ifdef NDEBUG
+#undef NDEBUG
+#endif
+#include <CrossPointSettings.h>
+#include <HalStorage.h>
+
+#include <cassert>
+#include <cstdio>
+#include <optional>
+
+#include "util/PluginLocations.h"
+namespace BoardConfig {
+struct Profile {
+  int displayWidth = 800, displayHeight = 480;
+};
+inline Profile ACTIVE;
+bool isSticky() { return true; }
+bool isX4Pro() { return false; }
+bool isPaperMono() { return false; }
+bool isMetalioEInk4() { return false; }
+}  // namespace BoardConfig
+namespace pluginevents {
+std::vector<PluginLocations::Entry> entries;
+bool prepared = false;
+void discardTimed() { prepared = false; }
+void refreshSubscriptions() { entries = PluginLocations::scanPlugins(); }
+uint64_t prepareTimed(int width, int height) {
+  assert(width == 480 && height == 800);
+  prepared = entries.size() == 1 && entries.front().hasDevice;
+  return prepared ? 60000000ULL : 0;
+}
+}  // namespace pluginevents
+struct Cred {
+  std::string ssid = "fixture";
+};
+struct WifiStore {
+  int loads = 0;
+  void loadFromFile() { ++loads; }
+  std::string getLastConnectedSsid() { return "fixture"; }
+  std::optional<Cred> findCredential(const std::string&) { return Cred{}; }
+} WIFI_STORE;
+static bool timerStorageReady = false;
+#include "PermissionSource.inc"
+static timedsource::Source preparedTimerSource = timedsource::Source::Off;
+#include "PrepareSource.inc"
+static uint64_t coldPrepare() {
+  timerStorageReady = Storage.ready() || Storage.begin();
+  if (!timerStorageReady || !SETTINGS.loadTimerSettings()) return 0;
+  return prepareTimerPanel();
+}
+static void write(const std::string& path, const std::string& contents) {
+  auto p = Storage.card / path.substr(1);
+  std::filesystem::create_directories(p.parent_path());
+  std::ofstream(p, std::ios::binary) << contents;
+}
+static std::string readSettings() {
+  std::ifstream in(Storage.card / ".crosspoint/settings.json", std::ios::binary);
+  return {std::istreambuf_iterator<char>(in), std::istreambuf_iterator<char>()};
+}
+static void reset() {
+  std::filesystem::remove_all(Storage.card);
+  std::filesystem::create_directories(Storage.card);
+  Storage.mounted = timerStorageReady = false;
+  Storage.canMount = true;
+  Storage.failRead = false;
+  SETTINGS = CrossPointSettings{};
+  WIFI_STORE = WifiStore{};
+  pluginevents::discardTimed();
+}
+int main(int argc, char** argv) {
+  assert(argc == 2);
+  Storage.card = argv[1];
+  struct Case {
+    const char* json;
+    uint64_t interval;
+    timedsource::Source source;
+    bool network;
+  };
+  using S = timedsource::Source;
+  const Case cases[] = {
+      {R"({"pluginsEnabled":1,"timedSleepSource":2})", 60000000ULL, S::Plugin, true},
+      {R"({"pluginsEnabled":0,"timedSleepSource":2})", 0, S::Off, false},
+      {R"({"pluginsEnabled":1})", 0, S::Off, false},
+      {R"({"timedSleepScreenRefresh":1,"sleepScreen":2})", 60000000ULL, S::Local, false},
+      {R"({"timedSleepSource":0,"timedSleepScreenRefresh":1,"sleepScreen":2})", 0, S::Off, false},
+      {R"({"timedSleepSource":1,"timedSleepScreenRefresh":1,"sleepScreen":2,"pluginsEnabled":0})", 60000000ULL,
+       S::Local, false},
+      {R"({"timedSleepSource":1,"timedSleepScreenRefresh":1,"sleepScreen":0})", 0, S::Off, false},
+      {R"({"timedSleepSource":null,"timedSleepScreenRefresh":1,"sleepScreen":2})", 0, S::Off, false},
+      {R"({"timedSleepSource":"2","pluginsEnabled":1})", 0, S::Off, false},
+      {R"({"timedSleepSource":3,"pluginsEnabled":1})", 0, S::Off, false},
+      {R"({"timedSleepSource":-1,"pluginsEnabled":1})", 0, S::Off, false},
+      {R"({"timedSleepSource":256,"pluginsEnabled":1})", 0, S::Off, false},
+      {R"({"timedSleepSource":1.5,"pluginsEnabled":1})", 0, S::Off, false},
+      {R"({"timedSleepSource":2,"pluginsEnabled":2})", 0, S::Off, false},
+      {R"({"timedSleepSource":2,"pluginsEnabled":"1"})", 0, S::Off, false},
+      {R"({"timedSleepSource":2,"pluginsEnabled":null})", 60000000ULL, S::Plugin, true},
+      {R"({"timedSleepSource":1,"timedSleepScreenRefresh":255,"sleepScreen":2})", 0, S::Off, false},
+      {"[]", 0, S::Off, false},
+      {"null", 0, S::Off, false},
+      {"{broken", 0, S::Off, false},
+      {R"({"timedSleepSource":2,"pluginsEnabled":1,"other":[--]})", 0, S::Off, false},
+  };
+  for (const auto& c : cases) {
+    reset();
+    write("/plugins/example/device.json", "{}");
+    write(CrossPointSettings::getFilePath(), c.json);
+    SETTINGS.pluginsEnabled = 1;
+    SETTINGS.timedSleepSource = 2;
+    assert(coldPrepare() == c.interval);
+    assert(preparedTimerSource == c.source);
+    assert(WIFI_STORE.loads == static_cast<int>(c.network));
+    assert(readSettings() == c.json && SETTINGS.readerSentinel == 42);
+  }
+  for (const char* root : PluginLocations::ROOTS) {
+    reset();
+    write(std::string(root) + "/example/device.json", "{}");
+    write(CrossPointSettings::getFilePath(), R"({"timedSleepSource":2})");
+    assert(coldPrepare() == 60000000ULL);
+    write(std::string(root) + "/example/.installing", "");
+    assert(coldPrepare() == 0);
+    assert(PluginLocations::findPluginDir("example").empty());
+  }
+  reset();
+  write("/.crosspoint/plugins/example/device.json", "{}");
+  write("/.crosspoint/plugins/example/.installing", "");
+  write("/plugins/example/device.json", "{}");
+  write(CrossPointSettings::getFilePath(), R"({"timedSleepSource":2,"pluginsEnabled":1})");
+  assert(coldPrepare() == 0);
+  for (int fault = 0; fault < 3; ++fault) {
+    reset();
+    write("/plugins/example/device.json", "{}");
+    std::string json = R"({"timedSleepSource":2,"pluginsEnabled":1})";
+    if (fault == 0) json.resize(16 * 1024 + 1, ' ');
+    if (fault == 1) Storage.failRead = true;
+    if (fault == 2) Storage.canMount = false;
+    write(CrossPointSettings::getFilePath(), json);
+    assert(coldPrepare() == 0 && WIFI_STORE.loads == 0 && readSettings() == json);
+  }
+  reset();
+  write("/plugins/example/device.json", "{}");
+  std::string json = R"({"timedSleepSource":2,"pluginsEnabled":1})";
+  json.resize(16 * 1024, ' ');
+  write(CrossPointSettings::getFilePath(), json);
+  assert(coldPrepare() != 0 && readSettings() == json);
+  reset();
+  write("/plugins/example/device.json", "{}");
+  assert(coldPrepare() == 0 && !SETTINGS.pluginsEnabled);
+  assert(HalFile::activeHandles == 0);
+  std::puts("21 settings cases + roots/quarantine/limits/missing-file PASS; settings unchanged");
+}
