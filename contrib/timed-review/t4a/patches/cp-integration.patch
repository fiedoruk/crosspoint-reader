diff --git a/lib/hal/PaperMonoTimer.h b/lib/hal/PaperMonoTimer.h
new file mode 100644
index 0000000..f1e8913
--- /dev/null
+++ b/lib/hal/PaperMonoTimer.h
@@ -0,0 +1,42 @@
+#pragma once
+
+#include <PaperMonoBoard.h>
+#include <Rtc.h>
+
+namespace papermonotimer {
+inline bool cancel() {
+  freeink::Rtc rtc;
+  const bool stopped = rtc.begin() && rtc.cancelWakeTimer();
+  const bool disabled = freeink::papermono::setRtcWake(false);
+  return stopped && disabled;
+}
+
+inline bool takeWake(bool& timerWake) {
+  timerWake = false;
+  if (!freeink::papermono::ensureBooted()) return false;
+  const auto wake = freeink::papermono::bootWakeState();
+  freeink::Rtc rtc;
+  bool fired = false;
+  const bool read = rtc.begin() && rtc.readWakeTimer(fired);
+  const bool stopped = rtc.present() && rtc.cancelWakeTimer();
+  const bool disabled = freeink::papermono::setRtcWake(false);
+  if (!read || !stopped || !disabled || !wake.valid) return false;
+  // Exclude a button/USB/reset flag or another enabled PMIC wake input.
+  timerWake = fired && wake.source == freeink::m5pm1::WAKE_EXTERNAL &&
+              (wake.enabledPins & freeink::m5pm1::GPIO_WAKE_MASK) == freeink::m5pm1::GPIO0;
+  return true;
+}
+
+inline bool arm(uint64_t intervalUs) {
+  if (!cancel()) return false;
+  if (!intervalUs) return true;
+  if (intervalUs % 1000000ULL || intervalUs / 1000000ULL > UINT32_MAX) return false;
+  freeink::Rtc rtc;
+  if (!rtc.begin() || !freeink::papermono::setRtcWake(true) ||
+      !rtc.armWakeTimer(static_cast<uint32_t>(intervalUs / 1000000ULL))) {
+    cancel();
+    return false;
+  }
+  return true;
+}
+}  // namespace papermonotimer
diff --git a/lib/hal/TimerWakeArm.h b/lib/hal/TimerWakeArm.h
new file mode 100644
index 0000000..8469d73
--- /dev/null
+++ b/lib/hal/TimerWakeArm.h
@@ -0,0 +1,43 @@
+#pragma once
+
+#include <Logging.h>
+#include <PowerManager.h>
+#include <esp_sleep.h>
+#include <esp_system.h>
+
+#include <cstdint>
+
+namespace timerwakearm {
+// Wake sources survive wakeup; zero must explicitly restore button-only sleep.
+inline void clearTimer() {
+  const auto disabled = esp_sleep_disable_wakeup_source(ESP_SLEEP_WAKEUP_TIMER);
+  if (disabled != ESP_OK && disabled != ESP_ERR_INVALID_STATE) {
+    // Do not sleep with a wake source whose state could not be cleared.
+    LOG_ERR("PWR", "Timer wake disable failed: %d; restarting", static_cast<int>(disabled));
+    esp_restart();
+  }
+}
+
+// Rejected timer requests fall back to button-only sleep.
+inline bool arm(const uint64_t intervalUs) {
+  if (intervalUs == 0) {
+    clearTimer();
+    return false;
+  }
+  const auto result = esp_sleep_enable_timer_wakeup(intervalUs);
+  if (result == ESP_OK) return true;
+  LOG_ERR("PWR", "Timer wake arming failed: %d", static_cast<int>(result));
+  clearTimer();
+  return false;
+}
+inline void sleep(const bool fromTimerWake) {
+  if (fromTimerWake) {
+    // A button arriving during timer teardown must wake us, not be consumed by
+    // waitForPowerButtonRelease(). A sleep abort restarts through the SDK.
+    freeink::PowerManager::armPowerButtonWakeup();
+    freeink::PowerManager::deepSleep();
+  } else {
+    freeink::PowerManager::deepSleepUntilPowerButton();
+  }
+}
+}  // namespace timerwakearm
