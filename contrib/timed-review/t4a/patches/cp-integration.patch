+static bool verifyWakeHold(wakeup::Reason wakeupReason, bool resumedTimerPower, bool capturedPowerVerified = false) {
+#include "WakeHoldSource.inc"
+  return wakeHoldVerified;
+}
+
+static void testWakeHold() {
+  using R = wakeup::Reason;
+  struct Case {
+    R reason;
+    bool resumed, takeover, metalio, held, accepted;
+    int checks;
+  };
+  const Case cases[] = {
+      {R::PowerButton, false, false, true, false, true, 0}, {R::PowerButton, false, false, false, false, false, 1},
+      {R::PowerButton, false, false, false, true, true, 1}, {R::Timer, false, true, false, false, false, 1},
+      {R::Timer, false, true, false, true, true, 1},        {R::Timer, false, false, false, false, true, 0},
+      {R::RtcTimer, false, true, false, true, true, 1},     {R::RtcTimer, false, false, false, false, true, 0},
+      {R::Other, true, false, false, false, false, 1},      {R::Other, false, false, false, false, true, 0},
+  };
+  for (const auto& c : cases) {
+    BoardConfig::metalio = c.metalio;
+    gpio.wakeHeld = c.held;
+    gpio.wakeHoldChecks = 0;
+    timerHooks.manualPower = c.takeover;
+    assert(verifyWakeHold(c.reason, c.resumed) == c.accepted);
+    assert(gpio.wakeHoldChecks == c.checks);
+  }
+}
+static bool runSync() {
+  gpio.beginPowerWakeCapture();
+  if (timerHooks.powerPressed()) return true;
+  if (!timerHooks.prepare()) return false;
+  timerHooks.sync();
+  gpio.endPowerWakeCapture();
+  return timerHooks.manualPower;
+}
+static void reset() {
+  nowMs = 0;
+  pressAt = UINT32_MAX;
+  gpio = GPIO{};
+  shortPressDuringPaint = shortPressDuringFetch = shortPressDuringTeardown = false;
+  timerManualWakeStamp = 0;
