diff --git a/test/plugin_verified_http/EventTrustTest.cpp b/test/plugin_verified_http/EventTrustTest.cpp
new file mode 100644
index 0000000..23b2a8d
--- /dev/null
+++ b/test/plugin_verified_http/EventTrustTest.cpp
@@ -0,0 +1,183 @@
+#include <HalStorage.h>
+#include <Logging.h>
+#include <SecureHttpClient.h>
+#include <TrustedTime.h>
+
+#include <cassert>
+#include <string>
+#include <vector>
+
+#include "util/PluginEvents.h"
+#include "util/PluginLocations.h"
+
+namespace PluginLocations {
+std::vector<Entry> entries;
+std::vector<Entry> scanPlugins() { return entries; }
+std::string findPluginDir(const char*) { return {}; }
+}  // namespace PluginLocations
+
+using Http = freeink::SecureHttpClient;
+uint32_t millis() { return trustedtime::fixtureMs; }
+static const std::string LINE = "{\"e\":\"sleep.enter\",\"id\":\"fixture-id\",\"ts\":1,\"vars\":{}}\n";
+static const std::string PEM = "-----BEGIN CERTIFICATE-----\n" + std::string(80, 'A') + "\n-----END CERTIFICATE-----\n";
+static std::string bmp(char color) {
+  std::string s(70, '\0');
+  for (size_t i = 54; i < s.size(); ++i) s[i] = color;
+  const auto le16 = [&](size_t at, uint16_t value) {
+    s[at] = static_cast<char>(value);
+    s[at + 1] = static_cast<char>(value >> 8);
+  };
+  const auto le32 = [&](size_t at, uint32_t value) {
+    for (size_t i = 0; i < 4; ++i) s[at + i] = static_cast<char>(value >> (i * 8));
+  };
+  le16(0, 0x4d42);
+  le32(2, 70);
+  le32(10, 54);
+  le32(14, 40);
+  le32(18, 2);
+  le32(22, 2);
+  le16(26, 1);
+  le16(28, 24);
+  le32(34, 16);
+  return s;
+}
+static void setup(const std::string& event, const std::string& auth = "") {
+  Storage.files.clear();
+  PluginLocations::entries = {{"test", "/plugins/test", false, true, false}};
+  Storage.files["/plugins/test/device.json"] =
+      "{\"token\":{\"file\":\"token.json\"}," + auth + "\"events\":{\"sleep.enter\":{" + event + "}}}";
+  Storage.files["/plugins/test/events.jsonl"] = LINE;
+  Storage.files["/plugins/test/token.json"] = "{\"token\":\"sentinel-query\"}";
+  Storage.files["/plugins/test/root.pem"] = PEM;
+  Http::begins = Http::sends = Http::insecureCalls = Http::caCalls = 0;
+  Http::replies.clear();
+  Http::urls.clear();
+  Http::headers.clear();
+  Http::bodies.clear();
+  Http::reply.clear();
+  Http::status = 200;
+  Http::complete = true;
+  Http::sendDelayMs = 0;
+  Http::abortAfterBody = false;
+  trustedtime::now = 1800000000;
+  trustedtime::fresh = false;
+  trustedtime::syncSucceeds = true;
+  trustedtime::syncAttempts = 0;
+  trustedtime::fixtureMs = 0;
+  trustedtime::syncDelayMs = 0;
+  fixturelog::output.clear();
+  pluginevents::refreshSubscriptions();
+}
+static bool queued() { return Storage.exists("/plugins/test/events.jsonl"); }
+int main() {
+  const std::string request =
+      R"("request":{"url":"https://example.test/frame?token={token}","headers":{"Authorization":"Bearer {token}"},"tls":{"ca_file":"root.pem"}})";
+  const std::string auth =
+      R"("auth":{"type":"password","request":{"url":"https://example.test/auth","tls":{"ca_file":"root.pem"}},"token_path":"access_token"},)";
+  setup(request);
+  pluginevents::drain(nullptr);
+#if TEST_PEER_VERIFICATION_AVAILABLE
+  assert(Http::sends == 1 && Http::caCalls == 1 && Http::insecureCalls == 0 && !queued());
+  assert(trustedtime::syncAttempts == 1);
+  assert(Http::headers[0] == "Authorization:Bearer sentinel-query");
+  setup(request);
+  Storage.files["/plugins/test/events.jsonl"] += LINE;
+  trustedtime::syncSucceeds = false;
+  pluginevents::drain(nullptr);
+  assert(Http::sends == 0 && trustedtime::syncAttempts == 1 && queued());
+  setup(request);
+  trustedtime::syncDelayMs = 15000;
+  pluginevents::drain(nullptr, 4, {4, 15000});
+  assert(Http::sends == 0 && trustedtime::syncAttempts == 1 && queued());
+  setup(R"("request":{"url":"http://example.test/legacy"})", auth);
+  Http::replies = {{401, ""}};
+  trustedtime::syncDelayMs = 5000;
+  pluginevents::drain(nullptr, 4, {1, 15000});
+  assert(Http::sends == 1 && queued() && trustedtime::syncAttempts == 0);
+  assert(trustedtime::fixtureMs == 0);
+  setup(request, auth);
+  Http::replies = {{401, ""}, {200, R"({"access_token":"fixture-new"})"}, {200, ""}};
+  Http::sendDelayMs = 1000;
+  pluginevents::drain(nullptr, 4, {3, 15000});
+  assert(Http::sends == 3 && Http::caCalls == 3 && Http::insecureCalls == 0 && !queued());
+  assert(trustedtime::syncAttempts == 1);
+  assert(Http::urls.back() == "https://example.test/frame?token=fixture-new");
+  assert(Storage.files["/plugins/test/token.json"].find("fixture-new") != std::string::npos);
+  setup(request, auth);
+  Http::replies = {{403, ""}, {200, R"({"access_token":"fixture-new"})"}, {403, ""}};
+  pluginevents::drain(nullptr, 4, {3, 15000});
+  assert(Http::sends == 3 && queued() && trustedtime::syncAttempts == 1);
+  setup(request, auth);
+  Http::replies = {{401, ""}, {200, R"({"access_token":"fixture-new"})"}, {200, ""}};
+  Http::sendDelayMs = 7500;
+  pluginevents::drain(nullptr, 4, {3, 15000});
+  assert(Http::sends == 2 && queued() && trustedtime::syncAttempts == 1);
