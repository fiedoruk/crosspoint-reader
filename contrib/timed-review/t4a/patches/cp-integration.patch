+++ b/test/plugin_verified_http/VerifiedHttpTest.cpp
@@ -0,0 +1,148 @@
+#include <ArduinoJson.h>
+#include <HalStorage.h>
+#include <Logging.h>
+#include <SecureHttpClient.h>
+#include <TrustedTime.h>
+
+#include <cassert>
+#include <string>
+
+#include "util/PluginEventTrust.h"
+#include "util/PluginHttp.h"
+
+int main() {
+  JsonDocument doc;
+  bool verified = false;
+  std::string caFile;
+  deserializeJson(doc, R"({"tls":{"ca_file":"certs/root.pem"}})");
+  plugineventtrust::read(doc.as<JsonVariantConst>(), verified, caFile);
+  assert(verified && caFile == "certs/root.pem");
+  deserializeJson(doc, R"({"tls":{"ca_file":42}})");
+  plugineventtrust::read(doc.as<JsonVariantConst>(), verified, caFile);
+  assert(verified && caFile.empty());
+  deserializeJson(doc, R"({"tls":null})");
+  plugineventtrust::read(doc.as<JsonVariantConst>(), verified, caFile);
+  assert(verified && caFile.empty());
+  deserializeJson(doc, R"({"tls":"ignored"})");
+  plugineventtrust::read(doc.as<JsonVariantConst>(), verified, caFile);
+  assert(verified && caFile.empty());
+  deserializeJson(doc, R"({"tls":{}})");
+  plugineventtrust::read(doc.as<JsonVariantConst>(), verified, caFile);
+  assert(verified && caFile.empty());
+  for (const auto& json :
+       {R"({"browse":{"tls":null}})", R"({"download":{"tls":42}})", R"({"auth":{"poll":{"tls":{}}}})"}) {
+    deserializeJson(doc, json);
+    assert(plugineventtrust::catalogHasTls(doc.as<JsonVariantConst>()));
+  }
+  deserializeJson(doc, "{}");
+  plugineventtrust::read(doc.as<JsonVariantConst>(), verified, caFile);
+  assert(!verified);
+  deserializeJson(doc, R"({"events":{"sleep.enter":{"request":{"tls":{"ca_file":"certs/root.pem"}}}}})");
+  assert(!plugineventtrust::catalogHasTls(doc.as<JsonVariantConst>()));
+  deserializeJson(doc, R"({"auth":{"request":{"tls":{"ca_file":"certs/root.pem"}}}})");
+  assert(plugineventtrust::catalogHasTls(doc.as<JsonVariantConst>()));
+  assert(!plugineventtrust::mayRefresh(true, false));
+  assert(plugineventtrust::mayRefresh(true, true));
+
+  const std::string pem = "-----BEGIN CERTIFICATE-----\n" + std::string(80, 'A') + "\n-----END CERTIFICATE-----\n";
+  Storage.files["/plugins/test/certs/root.pem"] = pem;
+  pluginhttp::VerifiedTrust trust{"/plugins/test", "certs/root.pem"};
+  String response;
+  const pluginhttp::Headers headers{{"Authorization", "Bearer fixture"}};
+  auto run = [&](const std::string& url, const pluginhttp::VerifiedTrust* t, freeink::SecureHttpClient* s = nullptr) {
+    return pluginhttp::request(s, url, "GET", "", headers, response, 1024, nullptr, nullptr, t);
+  };
+#if TEST_PEER_VERIFICATION_AVAILABLE
+  assert(run("https://example.test/x", &trust) == -1);
+  assert(freeink::SecureHttpClient::begins == 0);
+  trustedtime::fresh = true;
+  assert(run("https://example.test/x", &trust) == 200);
+  assert(freeink::SecureHttpClient::caCalls == 1 && freeink::SecureHttpClient::insecureCalls == 0);
+  assert(run("http://example.test/x", &trust) == -1);
+  const int beginsBeforeInvalidUrl = freeink::SecureHttpClient::begins;
+  const int sendsBeforeInvalidUrl = freeink::SecureHttpClient::sends;
+  const int caBeforeInvalidUrl = freeink::SecureHttpClient::caCalls;
+  fixturelog::output.clear();
+  for (const auto& invalid :
+       {std::string("https://example.test?token=sentinel-query"), std::string("https://sentinel-user@example.test/"),
+        std::string("https:///sentinel-empty"), std::string("https://"), std::string("https://:443/sentinel-empty"),
+        std::string("https://example.test#sentinel-fragment"), std::string("https://example.test/\nsentinel-control"),
+        std::string("https://example.test/") + std::string(1, '\0') + "sentinel-nul"}) {
+    assert(run(invalid, &trust) == -1);
+  }
+  assert(freeink::SecureHttpClient::begins == beginsBeforeInvalidUrl);
+  assert(freeink::SecureHttpClient::sends == sendsBeforeInvalidUrl);
+  assert(freeink::SecureHttpClient::caCalls == caBeforeInvalidUrl);
+  assert(fixturelog::output.find("sentinel") == std::string::npos);
+  assert(run("https://example.test/?token=fixture", &trust) == 200);
+
+  trustedtime::now = 0;
+  assert(run("https://example.test/x", &trust) == -1);
+  trustedtime::now = 1800000000;
+  trustedtime::systemNow = 0;
+  assert(run("https://example.test/x", &trust) == -1);
+  trustedtime::systemNow = 1799999999;
+  assert(run("https://example.test/x", &trust) == -1);
+  trustedtime::systemNow = 1800000000;
+  trust.caFile = "../other.pem";
+  assert(run("https://example.test/x", &trust) == -1);
+  trust.caFile.clear();
+  assert(run("https://example.test/x", &trust) == -1);
+  trust.caFile = "missing.pem";
+  assert(run("https://example.test/x", &trust) == -1);
+  trust.caFile = "certs/root.pem";
+  Storage.files["/plugins/test/certs/root.pem"] = "bad";
+  assert(run("https://example.test/x", &trust) == -1);
+  for (const auto& rel : {"/root.pem", "certs//root.pem", "certs/../root.pem", "certs/", "certs\\root.pem"}) {
+    trust.caFile = rel;
+    assert(run("https://example.test/x", &trust) == -1);
+  }
+  trust.caFile = "certs/root.pem";
+  for (const auto& invalid :
+       {std::string(), std::string(8193, 'A'), std::string("-----BEGIN CERTIFICATE-----\n") + std::string(80, 'A'),
+        std::string("-----BEGIN CERTIFICATE-----\n") + std::string(80, 'A') + std::string(1, '\0') +
+            "-----END CERTIFICATE-----"}) {
+    Storage.files["/plugins/test/certs/root.pem"] = invalid;
+    assert(run("https://example.test/x", &trust) == -1);
+  }
+  const int sends = freeink::SecureHttpClient::sends;
+  assert(pluginhttp::requestToFile(nullptr, "https://example.test/x", "GET", "", headers, "/plugins/test/out.part",
+                                   1024, nullptr, &trust) == -1);
+  std::string minted;
+  assert(!pluginhttp::mintPasswordToken(nullptr, "https://example.test/auth", "POST", "secret", headers, "access_token",
+                                        minted, nullptr, &trust));
+  assert(freeink::SecureHttpClient::sends == sends);
+  Storage.files["/plugins/test/certs/root.pem"] = pem;
+  freeink::SecureHttpClient::reply = "{\"access_token\":\"fixture-token\"}";
+  assert(pluginhttp::mintPasswordToken(nullptr, "https://example.test/auth", "POST", "fixture", headers, "access_token",
+                                       minted, nullptr, &trust));
+  assert(minted == "fixture-token");
+  freeink::SecureHttpClient::reply.clear();
+  assert(pluginhttp::requestToFile(nullptr, "https://example.test/x", "GET", "", headers, "/plugins/test/out.part",
+                                   1024, nullptr, &trust) == 200);
+  const int sendsBeforeAbort = freeink::SecureHttpClient::sends;
+  assert(pluginhttp::request(
+             nullptr, "https://example.test/x", "GET", "", headers, response, 1024, nullptr, [] { return true; },
+             &trust) == -1);
+  assert(freeink::SecureHttpClient::sends == sendsBeforeAbort);
+  freeink::SecureHttpClient::status = -1;
+  fixturelog::output.clear();
+  const std::string sensitive = "https://example.test/sentinel-path?token=sentinel-query";
+  assert(run(sensitive, &trust) == -1);
+  assert(pluginhttp::requestToFile(nullptr, sensitive, "POST", "sentinel-body", {{"Authorization", "sentinel-header"}},
+                                   "/plugins/test/out.part", 1024, nullptr, &trust) == -1);
+  assert(!Storage.exists("/plugins/test/out.part"));
+  assert(fixturelog::output.find("sentinel") == std::string::npos);
+  assert(!fixturelog::output.empty());
+  freeink::SecureHttpClient::status = 200;
+  freeink::SecureHttpClient insecureSession;
+  const int beginsAfterSuccess = freeink::SecureHttpClient::begins;
+  assert(run("https://example.test/x", &trust, &insecureSession) == -1);
+  assert(freeink::SecureHttpClient::begins == beginsAfterSuccess);
+#else
+  assert(run("https://example.test/x", &trust) == -1);
+  assert(freeink::SecureHttpClient::begins == 0);
+#endif
+  assert(run("http://example.test/x", nullptr) == 200);
+  assert(freeink::SecureHttpClient::insecureCalls == 1);
+}
