+"""Exercise the actual bounded timer settings reader, migration and source preparation."""
+from pathlib import Path
+import argparse, os, re, subprocess, tempfile
+root=Path(__file__).resolve().parents[2]
+here=Path(__file__).resolve().parent
+parser=argparse.ArgumentParser(description=__doc__)
+parser.add_argument("--arduinojson",type=Path,default=Path(os.environ.get("CROSSPOINT_ARDUINOJSON_INCLUDE",root/".pio/libdeps/sticky/ArduinoJson/src")))
+args=parser.parse_args()
+assert (args.arduinojson/"ArduinoJson.h").is_file()
+settings=(root/"src/CrossPointSettings.cpp").read_text()
+start=settings.index("uint8_t timerSourceFromJson(")
+helper=settings[start:settings.index("\n}\n",start)+3]
+method=settings[settings.index("bool CrossPointSettings::loadTimerSettings() {"):]
+header=(root/"src/CrossPointSettings.h").read_text()
+enums=[]
+for name in ["SLEEP_SCREEN_MODE","TIMED_SLEEP_SCREEN_REFRESH","SLEEP_SCREEN_COVER_MODE","SLEEP_SCREEN_COVER_FILTER"]:
+    match=re.search(r"  enum "+name+r" \{.*?\};",header,re.S)
+    assert match, name
+    enums.append(match.group(0))
+start=header.index("  uint64_t getTimedSleepScreenRefreshUs() const {")
+interval=header[start:header.index("\n  }",start)+4]
+main=(root/"src/main.cpp").read_text()
+start=main.index("static timedsource::Source selectedTimerSource()")
+selectors=main[start:main.index("void enterDeepSleep(",start)]
+start=main.index("static uint64_t prepareTimerPanel() {",main.index("static bool timerStorageReady"))
+prepare=main[start:main.index("static bool syncTimerPanel()",start)]
+with tempfile.TemporaryDirectory(prefix="timer-settings-") as tmp:
+    temp=Path(tmp)
+    for name,body in [("PermissionSource.inc",helper+method),("PrepareSource.inc",selectors+prepare),
+                      ("TimerSettingEnums.inc","\n".join(enums)),("TimerSettingInterval.inc",interval)]:
+        (temp/name).write_text(body)
+    exe=temp/"settings"
+    subprocess.run(["c++","-std=c++20","-O0","-Wall","-Wextra","-Werror","-Wno-unused-function",
+                    "-fsanitize=address,undefined","-fno-omit-frame-pointer","-I"+str(temp),
+                    "-I"+str(here/"stubs"),"-I"+str(args.arduinojson),"-I"+str(root/"src"),
+                    str(root/"src/util/PluginLocations.cpp"),str(here/"PermissionTest.cpp"),"-o",str(exe)],check=True)
+    subprocess.run([str(exe),str(temp/"card")],check=True)
+assert "loadFromFile(" not in method and "saveToFile(" not in method and "requestResave(" not in method
+assert main.index("timerSettingsReady = timerStorageReady && SETTINGS.loadTimerSettings()") < main.index("timedwake::handleBoot(")
+assert "timedSleepSource = timerSourceFromJson(doc, getTimedSleepScreenRefreshUs());" in settings
