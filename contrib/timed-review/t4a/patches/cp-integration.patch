@@ -0,0 +1,28 @@
+"""Run actual PluginHttp and PluginEvents against bounded host stubs."""
+from pathlib import Path
+import argparse
+import subprocess
+import tempfile
+parser = argparse.ArgumentParser()
+parser.add_argument("--arduinojson", type=Path)
+parser.add_argument("--sanitize", action="store_true")
+args = parser.parse_args()
+root = Path(__file__).resolve().parents[2]
+here = Path(__file__).resolve().parent
+json = args.arduinojson or root / ".pio/libdeps/x4pro/ArduinoJson/src"
+with tempfile.TemporaryDirectory(prefix="plugin-verified-http-") as tmp:
+    modes = [
+        ("older-sdk", []),
+        ("backend-disabled", ["-DTEST_SDK_CAPABILITY", "-DTEST_PEER_VERIFICATION_AVAILABLE=0"]),
+        ("verified-sdk", ["-DTEST_SDK_CAPABILITY", "-DTEST_PEER_VERIFICATION_AVAILABLE=1"]),
+    ]
+    for mode, flags in modes:
+        for test in ("VerifiedHttpTest.cpp", "EventTrustTest.cpp"):
+            exe = Path(tmp) / "check"
+            cmd = ["c++", "-std=c++20", "-O0", "-g", "-I", str(here / "stubs"), "-I", str(root / "test/plugin_event_budget/stubs"), "-I", str(json), "-I", str(root / "src"), "-I", str(root / "lib/GfxRenderer"), "-I", str(root / "lib/Memory"), str(root / "src/util/PluginHttp.cpp")]
+            if test == "EventTrustTest.cpp": cmd += [str(root / "src/util/PluginEvents.cpp"), str(root / "src/util/PluginEventAsset.cpp"), str(root / "lib/GfxRenderer/Bitmap.cpp"), str(root / "lib/GfxRenderer/BitmapHelpers.cpp")]
+            cmd += flags
+            if args.sanitize: cmd += ["-fsanitize=address,undefined", "-fno-omit-frame-pointer"]
+            subprocess.run(cmd + [str(here / test), "-o", str(exe)], check=True)
+            subprocess.run([str(exe)], check=True)
+            print(f"PASS {test} mode={mode}", flush=True)
