+}
+static void testUsbColdBoot() {
+  const auto attempt = [] {
+    try {
+      usbColdBoot();
+    } catch (const Slept&) {
+      return;
+    }
+#if !FREEINK_DEVICE_X4PRO
+    assert(false && "sleep-on-USB board must enter standby");
+#endif
+  };
+#if FREEINK_DEVICE_X4PRO
+  reset();
+  attempt();
+  assert(powerManager.lastInterval == UINT64_MAX && trace.empty());
+#else
+  reset();
+  SETTINGS.timedSleepSource = static_cast<uint8_t>(timedsource::Source::Off);
+  attempt();
+  assert(powerManager.lastInterval == 0 && !powerManager.lastFromTimer);
+  reset();
+  attempt();
+  assert(powerManager.lastInterval == 60000000ULL && powerManager.lastFromTimer);
+  reset();
+  SETTINGS.timedSleepSource = static_cast<uint8_t>(timedsource::Source::Local);
+  powerManager.battery = 5;
+  attempt();
+  assert(powerManager.lastInterval == 120000000ULL);
+  reset();
+  powerManager.battery = 19;
+  attempt();
+  assert(powerManager.lastInterval == 0);
+  reset();
+  SETTINGS.pluginsEnabled = 0;
+  attempt();
+  assert(powerManager.lastInterval == 0);
+  reset();
+  credential = false;
+  attempt();
+  assert(powerManager.lastInterval == 0);
+  reset();
+  handler = false;
+  attempt();
+  assert(powerManager.lastInterval == 0);
+#endif
+  assert(WiFi.begins == 0 && initCalls == 0 && paintCalls == 0 && localPaintCalls == 0);
+}
+
+int main() {
+  testUsbColdBoot();
+#ifdef TEST_USB_ONLY
+  return 0;
+#endif
+  reset();
+  SETTINGS.timedSleepSource = static_cast<uint8_t>(timedsource::Source::Local);
+  SETTINGS.pluginsEnabled = 0;
+  powerManager.battery = 5;
+  assert(prepareTimerPanel() == 120000000ULL && timerMinimumBatteryPercent() == 0);
+  assert(!syncTimerPanel() && localPaintCalls == 1 && paintCalls == 0 && WiFi.begins == 0);
+  reset();
+  SETTINGS.timedSleepSource = static_cast<uint8_t>(timedsource::Source::Local);
+  SETTINGS.localInterval = 0;
+  assert(prepareTimerPanel() == 0 && preparedTimerSource == timedsource::Source::Off && WiFi.begins == 0);
+  reset();
+  SETTINGS.timedSleepSource = static_cast<uint8_t>(timedsource::Source::Off);
+  assert(prepareTimerPanel() == 0 && !pluginevents::prepared && WiFi.begins == 0);
+  reset();
+  assert(verifyWakeHold(wakeup::Reason::PowerButton, true, true));
+  assert(gpio.wakeHoldChecks == 0);
+  reset();
+  SETTINGS.pluginsEnabled = 0;
+  assert(timerHooks.prepare() == 0);
+  assert(WiFi.begins == 0 && !pluginevents::prepared);
+  reset();
+  assert(prepareTimerPanel() == 60000000ULL);
+  testWakeHold();
+  reset();
+  Storage.ok = false;
+  assert(!runSync());
+  assert(WiFi.begins == 0 && initCalls == 0 && !timerStorageReady);
+  reset();
+  handler = false;
+  assert(!runSync());
+  assert(WiFi.begins == 0 && initCalls == 0);
+  reset();
+  credential = false;
+  assert(!runSync());
+  assert(WiFi.begins == 0 && initCalls == 0);
+  reset();
+  emptySsid = true;
+  assert(timerHooks.prepare() == 0);
+  assert(!pluginevents::prepared && WiFi.begins == 0 && trustedtime::syncStarts == 0);
+  reset();
+  assert(timerHooks.prepare());
+  emptySsid = true;  // Defensive recheck in the actual sync caller.
+  assert(!syncTimerPanel());
+  assert(!pluginevents::prepared && WiFi.begins == 0 && trustedtime::syncStarts == 0);
+  reset();
+  WiFi.canJoin = false;
+  assert(!runSync());
+  assert(nowMs == 10000 && initCalls == 0 && WiFi.modeValue == WIFI_OFF && trustedtime::syncStarts == 0);
+  reset();
+  pluginevents::state = pluginevents::TimedState::Failure;
+  assert(!runSync());
+  assert(initCalls == 0 && paintCalls == 0 && WiFi.modeValue == WIFI_OFF);
+  reset();
+  assert(!runSync());
+  assert(initCalls == 1 && paintCalls == 1 && timerStorageReady && timerDisplayReady);
+  assert(nowMs == 0 && trustedtime::syncStarts == 1);
+  assert(trace == std::vector<std::string>({"SD", "STA", "JOIN", "FETCH", "INIT", "PAINT", "OFF"}));
+  reset();
+  shortPressDuringPaint = true;
+  assert(runSync());
+  assert(paintCalls == 1 && !gpio.rawPowerButtonPressed());
+  assert(!gpio.captureActive && WiFi.modeValue == WIFI_OFF);
+  reset();
+  shortPressDuringFetch = true;
+  assert(runSync());
+  assert(paintCalls == 0 && !gpio.rawPowerButtonPressed());
+  assert(!gpio.captureActive && WiFi.modeValue == WIFI_OFF);
+  reset();
+  trustedtime::clockElapsedMs = 5000;
+  fetchElapsedMs = 10000;
+  assert(!runSync());
+  assert(nowMs == 15000 && trustedtime::syncStarts == 1);
+  assert(initCalls == 0 && paintCalls == 0 && WiFi.modeValue == WIFI_OFF);
+  reset();
+  trustedtime::clockElapsedMs = 4999;
+  fetchElapsedMs = 9999;
+  assert(!runSync());
+  assert(nowMs == 14998 && initCalls == 1 && paintCalls == 1);
+  reset();
+  powerManager.battery = 19;
+  assert(!runSync());
+  assert(initCalls == 0 && paintCalls == 0);
+  reset();
+  WiFi.canJoin = false;
+  pressAt = 200;
+  assert(runSync());
+  assert(initCalls == 0 && nowMs == 200 && WiFi.modeValue == WIFI_OFF && trustedtime::syncStarts == 0);
+  reset();
+  trustedtime::clockReady = false;
+  assert(!runSync());
+  assert(nowMs == 10000 && initCalls == 0 && paintCalls == 0 && WiFi.modeValue == WIFI_OFF);
+  for (const auto& event : trace) assert(event != "FETCH");
+  reset();
+  trustedtime::clockReady = false;
+  pressAt = 100;
+  assert(runSync());
+  assert(nowMs == 100 && initCalls == 0 && WiFi.modeValue == WIFI_OFF);
+  for (const auto& event : trace) assert(event != "FETCH");
+  reset();
+  pressAt = 0;
+  assert(runSync());
+  assert(trace.empty() && trustedtime::syncStarts == 0);
+  reset();
+  WiFi.canJoin = false;
+  pressAt = 200;
+  timerHooks.prepare();
+  timerHooks.sync();
+  pressAt = UINT32_MAX;
+  assert(timerHooks.powerPressed());  // Observed Power remains latched after release.
+  reset();
+  assert(timerHooks.prepare() == 60000000ULL);
+  assert(timerStorageReady && Storage.mounted && pluginevents::prepared);
+  assert(timerHooks.prepare() == 60000000ULL);
+  assert(trace == std::vector<std::string>({"SD"}));
+  pluginevents::discardTimed();
+  assert(!pluginevents::prepared);
+  reset();
+  timerStorageReady = timerDisplayStarted = true;
+  try {
+    timerHooks.sleep(60000000);
+    assert(false);
+  } catch (const Slept&) {
+  }
+  assert(trace == std::vector<std::string>({"DISPLAY_SLEEP", "SD_SLEEP", "SLEEP"}));
+  assert(deepSleepInProgress);
+  reset();
+  timerStorageReady = timerDisplayStarted = true;
+  gpio.beginPowerWakeCapture();
+  shortPressDuringTeardown = true;
+  try {
+    timerHooks.sleep(60000000);
+    assert(false);
+  } catch (const Restarted&) {
+  }
+  assert(timerManualWakeStamp == timedwake::MANUAL_WAKE_STAMP);
+  assert(timedwake::consumeManualWake(wakeup::RST_SW, timerManualWakeStamp));
+  assert(timerManualWakeStamp == 0 && !gpio.rawPowerButtonPressed());
+  reset();
+  timerDisplayStarted = true;  // Partial display init still gets teardown.
+  try {
+    timerHooks.sleep(0);
+    assert(false);
+  } catch (const Slept&) {
+  }
+  assert(trace == std::vector<std::string>({"DISPLAY_SLEEP", "SLEEP"}));
+  reset();
+  timerStorageReady = timerDisplayStarted = true;
+  Storage.mounted = true;
+  try {
+    returnToTimerStandby();
+    assert(false);
+  } catch (const Slept&) {
+  }
+  assert(powerManager.lastInterval == 60000000ULL && powerManager.lastFromTimer);
+  assert(trace == std::vector<std::string>({"LIGHT_OFF", "TILT_SLEEP", "DISPLAY_SLEEP", "SD_SLEEP", "SLEEP"}));
+  assert(!pluginevents::prepared);
+  reset();
+  timerStorageReady = timerDisplayStarted = true;
+  Storage.mounted = true;
+  handler = false;
+  try {
+    returnToTimerStandby();
+    assert(false);
+  } catch (const Slept&) {
+  }
+  assert(powerManager.lastInterval == 0 && !pluginevents::prepared);
+  assert(trace == std::vector<std::string>({"LIGHT_OFF", "TILT_SLEEP", "DISPLAY_SLEEP", "SD_SLEEP", "SLEEP"}));
+  reset();
+  timerStorageReady = timerDisplayStarted = true;
+  Storage.mounted = true;
+  powerManager.battery = 19;
+  try {
+    returnToTimerStandby();
+    assert(false);
+  } catch (const Slept&) {
+  }
+  assert(powerManager.lastInterval == 0 && !pluginevents::prepared);
+  assert(trace == std::vector<std::string>({"LIGHT_OFF", "TILT_SLEEP", "DISPLAY_SLEEP", "SD_SLEEP", "SLEEP"}));
+}
diff --git a/test/timed_sync/PaintTest.cpp b/test/timed_sync/PaintTest.cpp
new file mode 100644
index 0000000..7c343bc
--- /dev/null
+++ b/test/timed_sync/PaintTest.cpp
@@ -0,0 +1,106 @@
+#include <GfxRenderer.h>
+#include <HalStorage.h>
+
+#include <cassert>
+#include <new>
+#include <string>
+
+#include "util/TimedSleepPaint.h"
+static int allocationToFail = 0;
+void* operator new(std::size_t size, const std::nothrow_t&) noexcept {
+  if (allocationToFail > 0 && --allocationToFail == 0) return nullptr;
+  try {
+    return ::operator new(size);
+  } catch (...) {
+    return nullptr;
+  }
+}
+static std::string bmp() {
+  std::string bytes(94, '\0');
+  auto put = [&](int at, unsigned n) {
+    for (int i = 0; i < 4; ++i) bytes[at + i] = static_cast<char>(n >> (8 * i));
+  };
+  bytes[0] = 'B';
+  bytes[1] = 'M';
+  put(2, 94);
+  put(10, 62);
+  put(14, 40);
+  put(18, 8);
+  put(22, 8);
+  bytes[26] = 1;
+  bytes[28] = 1;
+  bytes[58] = bytes[59] = bytes[60] = static_cast<char>(255);
+  return bytes;
+}
+int main() {
+  const std::string path = "/sleep.bmp", staged = path + ".part";
+  const std::string old = [] {
+    auto bytes = bmp();
+    bytes.back() = 85;
+    return bytes;
+  }();
+  const auto reset = [&] {
+    Storage = StorageStub{};
+    Storage.files[path] = old;
+    Storage.files[staged] = bmp();
+  };
+  reset();
+  GfxRenderer ok;
+  assert(timedsleeppaint::paint(ok, path, {}));
+  assert(ok.paints == 1 && ok.draws == 1);
+  assert(Storage.files[path] == bmp() && !Storage.exists(staged.c_str()));
+  reset();
+  GfxRenderer bad;
+  bad.failDraw = true;
+  assert(!timedsleeppaint::paint(bad, path, {}));
+  assert(bad.paints == 0 && Storage.files[path] == old);
+  reset();
+  Storage.readStop = 70;
+  GfxRenderer shortRow;
+  assert(!timedsleeppaint::paint(shortRow, path, {}));
+  assert(shortRow.draws == 1 && shortRow.paints == 0);
+  assert(Storage.files[path] == old);  // Valid header, unreadable row: do not replace.
+  reset();
+  GfxRenderer dim;
+  dim.width = 9;
+  assert(!timedsleeppaint::paint(dim, path, {}));
+  assert(dim.paints == 0 && Storage.files[path] == old);
+  reset();
+  Storage.files[staged] = "bad";
+  GfxRenderer header;
+  assert(!timedsleeppaint::paint(header, path, {}));
+  assert(header.paints == 0 && Storage.files[path] == old);
+  reset();
+  GfxRenderer manual;
+  int checks = 0;
+  assert(!timedsleeppaint::paint(manual, path, [&] { return ++checks == 3; }));
+  assert(manual.draws == 1 && manual.paints == 0 && Storage.files[path] == old);
+  reset();
+  Storage.failRead = staged;
+  GfxRenderer sd;
+  assert(!timedsleeppaint::paint(sd, path, {}));
+  assert(sd.paints == 0 && Storage.files[path] == old);
+  reset();
+  Storage.failRenameTo = path + ".bak";
+  GfxRenderer rename;
+  assert(!timedsleeppaint::paint(rename, path, {}));
+  assert(rename.draws == 1 && rename.paints == 0 && Storage.files[path] == old);
+  reset();
+  Storage.failRenameFrom = staged;
+  GfxRenderer restore;
+  assert(!timedsleeppaint::paint(restore, path, {}));
+  assert(restore.paints == 0 && Storage.files[path] == old);
+  reset();
+  bool powerDuringCommit = false;
+  Storage.afterRename = [&] { powerDuringCommit = true; };
+  GfxRenderer commitThenPower;
+  assert(timedsleeppaint::paint(commitThenPower, path, [&] { return powerDuringCommit; }));
+  assert(powerDuringCommit && commitThenPower.paints == 1 && Storage.files[path] == bmp());
+  reset();
+  GfxRenderer allocationFailure;
+  allocationToFail = 2;  // Prevalidation succeeds; the paint decoder allocation fails.
+  assert(!timedsleeppaint::paint(allocationFailure, path, {}));
+  assert(allocationToFail == 0 && allocationFailure.paints == 0);
+  assert(allocationFailure.clears == 0 && allocationFailure.draws == 0);
+  assert(Storage.files[path] == old);
+}
