 void configureSntp() {
   // SNTP uses UTC epochs regardless of the display timezone. Copy TZ before
@@ -135,6 +147,77 @@ bool syncNow(const uint32_t timeoutMs) {
   return synced;
 }
 
+bool syncFresh(const uint32_t timeoutMs, const std::function<bool()>& shouldAbort) {
+  uint32_t before;
+  int64_t floor;
+  portENTER_CRITICAL(&ramFloorLock);
+  fresh = false;
+  floor = ramFloor;
+  portEXIT_CRITICAL(&ramFloorLock);
+  // A failed new cycle must not inherit proof from the preceding cycle.
+  if (timeoutMs == 0 || (shouldAbort && shouldAbort())) return false;
+  const int64_t persisted = readFloor();
+  if (persisted > floor) floor = persisted;
+  // configTzTime restarts SNTP while retaining the existing display timezone.
+  configureSntp();
+  // Arm after restart: a callback racing with configTzTime is not proof of
+  // this attempt. Missing that callback fails closed and can retry next cycle.
+  portENTER_CRITICAL(&ramFloorLock);
+  before = callbackGeneration;
+  portEXIT_CRITICAL(&ramFloorLock);
+  const uint32_t started = static_cast<uint32_t>(millis());
+  const uint32_t waitMs = timeoutMs < 10000 ? timeoutMs : 10000;
+  while (true) {
+    if (shouldAbort && shouldAbort()) return false;
+    uint32_t generation;
+    int64_t epoch;
+    portENTER_CRITICAL(&ramFloorLock);
+    generation = callbackGeneration;
+    epoch = callbackEpoch;
+    portEXIT_CRITICAL(&ramFloorLock);
+    if (generation != before) {
+      if (shouldAbort && shouldAbort()) return false;
+      const int64_t now = static_cast<int64_t>(time(nullptr));
+      if (epoch < MIN_VALID_EPOCH || epoch < floor || now < epoch || now < floor) return false;
+      portENTER_CRITICAL(&ramFloorLock);
+      freshEpoch = epoch;
+      freshAtMs = static_cast<uint32_t>(millis());
+      fresh = true;
+      portEXIT_CRITICAL(&ramFloorLock);
+      if (shouldAbort && shouldAbort()) {
+        portENTER_CRITICAL(&ramFloorLock);
+        fresh = false;
+        portEXIT_CRITICAL(&ramFloorLock);
+        return false;
+      }
+      LOG_DBG("TIME", "Fresh SNTP sync in %lu ms",
+              static_cast<unsigned long>(static_cast<uint32_t>(millis()) - started));
+      return true;
+    }
+    const uint32_t elapsed = static_cast<uint32_t>(millis()) - started;
+    if (elapsed >= waitMs) {
+      LOG_DBG("TIME", "Fresh SNTP sync timed out after %lu ms", static_cast<unsigned long>(elapsed));
+      return false;
+    }
+    delay((waitMs - elapsed) < 50 ? waitMs - elapsed : 50);
+  }
+}
+
+bool hasFreshSync() {
+  uint32_t at;
+  int64_t epoch;
+  int64_t floor;
+  bool valid;
+  portENTER_CRITICAL(&ramFloorLock);
+  at = freshAtMs;
+  epoch = freshEpoch;
+  floor = ramFloor;
+  valid = fresh;
+  portEXIT_CRITICAL(&ramFloorLock);
+  const int64_t now = static_cast<int64_t>(time(nullptr));
+  return valid && static_cast<uint32_t>(millis()) - at < 30000 && now >= epoch && now - epoch < 30 && now >= floor;
+}
