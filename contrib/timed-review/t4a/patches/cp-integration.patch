diff --git a/src/util/TimedWakeGuard.h b/src/util/TimedWakeGuard.h
new file mode 100644
index 0000000..98d7654
--- /dev/null
+++ b/src/util/TimedWakeGuard.h
@@ -0,0 +1,59 @@
+#pragma once
+
+#include <WakeupClassify.h>
+
+#include <cstdint>
+
+// One timer owner; the caller selects the consumer and its battery policy.
+namespace timedwake {
+// One-shot handoff when Power arrives after peripheral teardown has started.
+inline constexpr uint32_t MANUAL_WAKE_STAMP = 0x54505752;
+inline constexpr uint32_t VERIFIED_WAKE_STAMP = 0x54505756;
+inline bool consumeManualWake(const int resetReason, uint32_t& stamp, bool* verified = nullptr) {
+  if (verified) *verified = resetReason == wakeup::RST_SW && stamp == VERIFIED_WAKE_STAMP;
+  const bool pending = resetReason == wakeup::RST_SW && (stamp == MANUAL_WAKE_STAMP || stamp == VERIFIED_WAKE_STAMP);
+  stamp = 0;
+  return pending;
+}
+
+struct Boot {
+  wakeup::Reason reason;
+  int resetReason;
+  bool supportedModel;
+  bool interruptedStartup;
+  uint16_t minimumBatteryPercent = 20;
+};
+
+inline uint64_t sleepInterval(const uint64_t configured, const bool supportedModel, const uint16_t batteryPercent) {
+  return supportedModel && batteryPercent >= 20 ? configured : 0;
+}
+
+// A Power takeover follows the same click-vs-hold wake preference as a
+// power-button deep-sleep wake. The press itself is latched by the caller.
+inline bool acceptManualWake(const bool heldThroughVerification, const bool clickWakeAllowed) {
+  return heldThroughVerification || clickWakeAllowed;
+}
+
+// sync() is called only on a qualified autonomous boot, never on normal wake.
+// Hooks must latch any manual Power observed during sync, including a short tap.
+template <typename Hooks>
+bool handleBoot(const Boot& boot, Hooks& hooks) {
+  const bool timer = boot.reason == wakeup::Reason::Timer && boot.resetReason == wakeup::RST_DEEPSLEEP;
+  const bool rtc = boot.reason == wakeup::Reason::RtcTimer && boot.resetReason == wakeup::RST_POWERON;
+  if (!timer && !rtc) return false;
+  if (hooks.powerPressed()) return false;
+  uint64_t interval = 0;
+  if (boot.supportedModel && !boot.interruptedStartup && hooks.batteryPercent() >= boot.minimumBatteryPercent) {
+    interval = hooks.prepare();
+  }
+  // Give a physical button arriving during the battery read priority.
+  if (hooks.powerPressed()) return false;
+  if (interval) {
+    hooks.sync();
+    if (hooks.powerPressed()) return false;
+    if (hooks.batteryPercent() < boot.minimumBatteryPercent) interval = 0;
+  }
+  hooks.sleep(interval);
+  return true;
+}
+}  // namespace timedwake
