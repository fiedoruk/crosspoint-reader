+// Actual timed selection, SDK TLS and BMP decode; SD, clock and panel are host boundaries.
+#include <GfxRenderer.h>
+#include <HalStorage.h>
+#include <SecureHttpClient.h>
+#include <TrustedTime.h>
+
+#undef time
+#include <ctime>
+#include <fstream>
+#include <iostream>
+#include <iterator>
+
+#include "util/PluginDrainBudget.h"
+#include "util/PluginEvents.h"
+#include "util/PluginLocations.h"
+#include "util/TimedSleepPaint.h"
+
+namespace PluginLocations {
+std::vector<Entry> scanPlugins() { return {{"fixture", "/plugins/fixture", false, true, false}}; }
+std::string findPluginDir(const char*) { return {}; }
+}  // namespace PluginLocations
+static std::string read(const char* name) {
+  std::ifstream input(name, std::ios::binary);
+  return {std::istreambuf_iterator<char>(input), std::istreambuf_iterator<char>()};
+}
+int main(int argc, char** argv) {
+  if (argc != 4) return 2;
+  const auto now = static_cast<int64_t>(std::time(nullptr));
+  trustedtime::now = trustedtime::systemNow = now;
+  trustedtime::fresh = true;
+  const std::string asset = read(argv[3]);
+  if (asset.empty()) return 2;
+  std::string old = asset;
+  old.back() ^= 0x55;
+  Storage.files["/sleep.bmp"] = old;
+  Storage.files["/plugins/fixture/ca.pem"] = read(argv[2]);
+  Storage.files["/plugins/fixture/token.json"] = R"({"token":"TEST-ONLY-TOKEN"})";
+  Storage.files["/plugins/fixture/device.json"] =
+      std::string(
+          R"({"token":{"file":"token.json"},"events":{"sleep.timer":{"interval_seconds":60,"download":{"url":"https://good.test:)") +
+      argv[1] +
+      R"(/frame","headers":{"Authorization":"Bearer {token}"},"dest":"/sleep.bmp","format":"bmp","width":8,"height":8,"tls":{"ca_file":"ca.pem"}}}}})";
+  Storage.files["/plugins/fixture/events.jsonl"] = "private-reader-outbox";
+  Storage.files["/.crosspoint/state.json"] = "private-reader-position";
+  pluginevents::refreshSubscriptions();
+  const auto interval = pluginevents::prepareTimed(8, 8);
+  pluginevents::DrainBudget budget(4, 15000, []() -> uint32_t { return millis(); });
+  const auto result = pluginevents::timedSync(budget, {});
+  GfxRenderer renderer;
+  const bool painted =
+      result.state == pluginevents::TimedState::Staged && timedsleeppaint::paint(renderer, result.asset, {});
+  Storage.remove("/sleep.bmp.part");
+  std::cout << "{\"armed_us\":" << interval << ",\"painted\":" << (painted ? "true" : "false")
+            << ",\"paints\":" << renderer.paints
+            << ",\"old_preserved\":" << (Storage.files["/sleep.bmp"] == old ? "true" : "false")
+            << ",\"private_unchanged\":"
+            << ((Storage.files["/plugins/fixture/events.jsonl"] == "private-reader-outbox" &&
+                 Storage.files["/.crosspoint/state.json"] == "private-reader-position")
+                    ? "true"
+                    : "false")
+            << "}\n";
+}
diff --git a/test/timed_sync/TimedSyncTest.cpp b/test/timed_sync/TimedSyncTest.cpp
