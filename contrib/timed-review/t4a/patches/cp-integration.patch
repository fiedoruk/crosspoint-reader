+#pragma once
+
+#include <string>
+
+namespace plugineventasset {
+
+// Require exact dimensions; (0, 0) accepts any supported size for backup recovery.
+bool validBmp(const std::string& path, int width, int height);
+
+// Resolve a leftover .bak; false means validation, cleanup or restore failed.
+bool recover(const std::string& dest);
+
+// Replaces dest with a checked .part file; false leaves the old bytes at dest
+// or at dest.bak for recovery on the next drain.
+bool commit(const std::string& dest, int width, int height, int status);
+
+}  // namespace plugineventasset
diff --git a/src/util/PluginEventTrust.h b/src/util/PluginEventTrust.h
new file mode 100644
index 0000000..be96b6e
--- /dev/null
+++ b/src/util/PluginEventTrust.h
@@ -0,0 +1,29 @@
+#pragma once
+
+#include <ArduinoJson.h>
+
+#include <string>
+
+namespace plugineventtrust {
+
+// Only the event drain accepts tls.ca_file. A present but malformed value
+// remains opted in, so transport can fail closed instead of using legacy HTTP.
+inline void read(JsonVariantConst req, bool& verified, std::string& caFile) {
+  verified = !req["tls"].isUnbound();
+  caFile.clear();
+  if (verified) {
+    const char* file = req["tls"]["ca_file"].as<const char*>();
+    if (file) caFile = file;
+  }
+}
+
+inline bool mayRefresh(bool eventVerified, bool authVerified) { return !eventVerified || authVerified; }
+
+// The catalog still uses a reusable legacy session. Reject any opt-in on a
+// shared catalog request so it cannot silently send credentials insecurely.
+inline bool catalogHasTls(JsonVariantConst root) {
+  return !root["browse"]["tls"].isUnbound() || !root["download"]["tls"].isUnbound() ||
+         !root["auth"]["request"]["tls"].isUnbound() || !root["auth"]["poll"]["tls"].isUnbound();
+}
+
+}  // namespace plugineventtrust
