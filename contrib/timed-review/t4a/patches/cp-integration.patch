+uint64_t prepareTimed(int width, int height) {
+  assert(width == 480 && height == 800);
+  prepared = handler;
+  return prepared ? 60000000ULL : 0;
+}
+Result timedSync(DrainBudget& budget, const std::function<bool()>& abort) {
+  assert(prepared);
+  prepared = false;
+  trace.push_back("FETCH");
+  if (!budget.beginAttempt()) return {TimedState::Failure, {}};
+  if (shortPressDuringFetch) gpio.shortPulse();
+  delay(fetchElapsedMs);
+  return {abort() ? TimedState::Failure : state, "/sleep.bmp"};
+}
+}  // namespace pluginevents
