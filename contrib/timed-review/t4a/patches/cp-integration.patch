+  portENTER_CRITICAL(&powerCaptureMux);
+  powerCapturePin = -1;
+  powerCaptureRequest = PowerWakeRequest::None;
+  powerCaptureDown = false;
+  portEXIT_CRITICAL(&powerCaptureMux);
