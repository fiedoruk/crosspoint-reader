new file mode 100644
index 0000000..80a3339
--- /dev/null
+++ b/test/plugin_verified_tls/README.md
@@ -0,0 +1,32 @@
+# CP-to-SDK verified HTTP test
+
+This test compiles the actual CP HTTP helper, checked BMP commit and SDK
+SecureClient/SecureHttpClient against a synthetic TLS server on 127.0.0.1.
+The server observes a synthetic Authorization marker; no account or service
+credentials are used. Temporary certificates and keys are removed on exit.
+
+The paired SDK patch adds a proposed backend capability. The runner also compiles
+an unmodified copy of the pinned SDK HEAD and the patched SDK without wolfSSL.
+Both must reject the opt-in without opening a connection. Legacy HTTP behavior
+remains unchanged, including its existing lack of peer verification.
+
+Requirements: C++20 compiler, Python 3 with `cryptography`, OpenSSL-backed Python
+`ssl`, ArduinoJson 7.4.2 headers and the pinned Arduino-wolfSSL host library.
+Build that library with the reproducible helper in the source-review package;
+the SDK source and headers must match the library settings.
+
+```
+python3 test/plugin_verified_tls/run.py \
+  --wolf-root /path/to/Arduino-wolfSSL \
+  --wolf-archive /path/to/libwolfssl-host.a \
+  --arduinojson /path/to/ArduinoJson/src \
+  --output /path/to/result.json
+```
+
+Cases cover request, download, password token mint, wrong hostname, untrusted CA,
+malformed CA, expired certificate, stale clock, invalid BMP, old SDK, disabled
+backend and legacy compatibility. The actual event drain and shared retry budget
+are tested separately by `plugin_verified_http`; this runner supplies a controlled
+clock proof and in-memory storage. It does not establish real SNTP timing, device
+heap, energy, SD durability or displayed pixels. Loopback transport uses POSIX
+sockets; the wolfSSL host library omits ESP-specific acceleration and allocators.
diff --git a/test/plugin_verified_tls/run.py b/test/plugin_verified_tls/run.py
new file mode 100644
index 0000000..312a2c6
--- /dev/null
+++ b/test/plugin_verified_tls/run.py
@@ -0,0 +1,104 @@
+#!/usr/bin/env python3
+"""Run actual CP-to-SDK verified HTTPS against a synthetic loopback TLS server."""
+import argparse
+import json
+from pathlib import Path
+import subprocess
+import tempfile
+
+from tls_fixture import LoopbackTLS, NOW, timedelta, issue, pem_cert, pem_key
+
+parser = argparse.ArgumentParser(description=__doc__)
+parser.add_argument("--wolf-root", type=Path, required=True)
+parser.add_argument("--wolf-archive", type=Path, required=True)
+parser.add_argument("--arduinojson", type=Path, required=True)
+parser.add_argument("--output", type=Path, required=True)
+args = parser.parse_args()
+root = Path(__file__).resolve().parents[2]
+here = Path(__file__).resolve().parent
+sdk = root / "freeink-sdk"
+sdk_source = "libs/network/SecureNet/src/SecureClient.cpp"
+sdk_include = "libs/network/SecureNet/include"
+flags = ["-std=c++20", "-O0", "-w", "-DFREEINK_NET_WOLFSSL=1", "-DWOLFSSL_USER_SETTINGS",
+         "-DWOLFSSL_OPTIONS_H", "-DWOLFSSL_CLIENT_EXAMPLE", "-DWOLFSSL_TLS13",
+         "-DWOLFSSL_HAVE_SP_ECC", "-DWOLFSSL_SP_SMALL", "-DHAVE_CURVE25519", "-DHAVE_SNI"]
+
+def bitmap():
+    data = bytearray(94)
+    data[:2] = b"BM"
+    for at, value in [(2, 94), (10, 62), (14, 40), (18, 8), (22, 8)]:
+        data[at:at+4] = value.to_bytes(4, "little")
+    data[26] = data[28] = 1
+    data[58:61] = bytes([255, 255, 255])
+    return bytes(data)
+
+results = []
+with tempfile.TemporaryDirectory(prefix="cp-sdk-verified-tls-") as temporary:
+    temp = Path(temporary)
+    raw = temp / "raw"
+    raw.mkdir()
+    for name, destination in [(sdk_source, raw / "SecureClient.cpp"),
+                              (sdk_include + "/SecureClient.h", raw / "SecureClient.h"),
+                              (sdk_include + "/SecureHttpClient.h", raw / "SecureHttpClient.h")]:
+        destination.write_bytes(subprocess.check_output(["git", "show", "HEAD:" + name], cwd=sdk))
+    for variant in ["verified", "old-sdk", "backend-disabled"]:
+        source = sdk / sdk_source if variant != "old-sdk" else raw / "SecureClient.cpp"
+        include = sdk / sdk_include if variant != "old-sdk" else raw
+        executable = temp / variant
+        used_flags = flags if variant != "backend-disabled" else ["-std=c++20", "-O0", "-w"]
+        command = ["nice", "-n", "10", "c++", *used_flags]
+        for path in [here / "transport_stubs", include, args.wolf_root / "src",
+                     root / "test/plugin_verified_http/stubs", root / "test/plugin_event_budget/stubs",
+                     args.arduinojson, root / "src", root / "lib/GfxRenderer", root / "lib/Memory"]:
+            command += ["-I", str(path)]
+        command += [str(source), str(root / "src/util/PluginHttp.cpp"),
+                    str(root / "src/util/PluginEventAsset.cpp"), str(root / "lib/GfxRenderer/Bitmap.cpp"),
+                    str(root / "lib/GfxRenderer/BitmapHelpers.cpp"), str(here / "NativeHttpTest.cpp")]
+        if variant != "backend-disabled": command += [str(args.wolf_archive)]
+        subprocess.run([*command, "-o", str(executable)], check=True)
+    frame = temp / "frame.bmp"
+    frame.write_bytes(bitmap())
+    key, ca = issue("Test root", ca=True)
+    ca_path = temp / "root.pem"
+    ca_path.write_bytes(pem_cert(ca))
+    cases = [
+        ("verified-request", "verified", "request", "good.test", "fresh", b"OK", True, False, False),
+        ("verified-download", "verified", "download", "good.test", "fresh", bitmap(), True, True, False),
+        ("verified-auth", "verified", "auth", "good.test", "fresh", b'{"access_token":"fixture-issued"}', True, False, True),
+        ("wrong-host", "verified", "download", "wrong.test", "fresh", bitmap(), False, False, False),
+        ("untrusted-root", "verified", "download", "good.test", "fresh", bitmap(), False, False, False),
+        ("invalid-ca", "verified", "download", "good.test", "fresh", bitmap(), False, False, False),
+        ("expired-peer", "verified", "download", "good.test", "fresh", bitmap(), False, False, False),
+        ("stale-clock", "verified", "download", "good.test", "stale", bitmap(), False, False, False),
+        ("malformed-bmp", "verified", "download", "good.test", "fresh", b"bad BMP", True, False, False),
+        ("old-sdk-refused", "old-sdk", "download", "good.test", "fresh", bitmap(), False, False, False),
+        ("backend-disabled", "backend-disabled", "download", "good.test", "fresh", bitmap(), False, False, False),
+        ("legacy-preserved", "old-sdk", "legacy", "wrong.test", "stale", b"OK", True, False, False),
+    ]
+    for name, variant, mode, san, clock, body, sent, committed, minted in cases:
+        issuer_key, issuer_ca = issue("Other root", ca=True) if name == "untrusted-root" else (key, ca)
+        expiry = {"start": NOW - timedelta(days=3), "end": NOW - timedelta(days=1)} if name == "expired-peer" else {}
+        leaf_key, leaf = issue("leaf", issuer_key, issuer_ca, san, **expiry)
+        ca_path.write_bytes(b"-----BEGIN CERTIFICATE-----\ninvalid-CA-data\n-----END CERTIFICATE-----\n"
+                            if name == "invalid-ca" else pem_cert(ca))
+        cert, secret = temp / "leaf.pem", temp / "leaf.key"
+        cert.write_bytes(pem_cert(leaf))
+        secret.write_bytes(pem_key(leaf_key))
+        with LoopbackTLS(cert, secret, payload=body) as server:
+            process = subprocess.run([str(temp / variant), mode, "good.test", str(server.port),
+                                      str(ca_path), str(frame), clock], capture_output=True, text=True, timeout=12)
+        assert process.returncode == 0, process.stderr
+        observed = json.loads(process.stdout)
+        token_seen = b"TEST-ONLY-TOKEN" in server.data
+        passed = (token_seen == sent and observed["committed"] == committed and observed["minted"] == minted
+                  and observed["capability"] == (variant == "verified")
+                  and observed["old_preserved"] == (not committed)
+                  and (observed["status"] == 200) == sent)
+        if not sent and name not in ("wrong-host", "untrusted-root", "expired-peer"): passed = passed and server.handshakes == 0
+        results.append({"case": name, "pass": passed, "protected_request_seen": token_seen,
+                        "handshakes": server.handshakes, "observed": observed})
+        assert passed, results[-1]
+args.output.write_text(json.dumps({"status": "PASS", "cases": results, "keys": "temporary and removed",
+                                  "transport": "POSIX loopback", "clock": "controlled; no SNTP proof",
+                                  "device": "NOT_TESTED"}, indent=2) + "\n")
+print(f"CP/SDK real TLS: {len(results)} cases passed; legacy and fail-closed capability paths covered")
diff --git a/test/plugin_verified_tls/tls_fixture.py b/test/plugin_verified_tls/tls_fixture.py
new file mode 100644
index 0000000..543b7d2
--- /dev/null
+++ b/test/plugin_verified_tls/tls_fixture.py
@@ -0,0 +1,96 @@
+"""Loopback TLS fixture against the actual SDK SecureClient and pinned wolfSSL."""
+from datetime import datetime, timedelta, timezone
+from pathlib import Path
+import socket
+import ssl
+import threading
+
+from cryptography import x509
+from cryptography.hazmat.primitives import hashes, serialization
+from cryptography.hazmat.primitives.asymmetric import ec
+from cryptography.x509.oid import NameOID
+
+NOW = datetime.now(timezone.utc)
+
+def issue(cn, issuer_key=None, issuer_cert=None, san=None, start=None, end=None, ca=False):
+    key = ec.generate_private_key(ec.SECP256R1())
+    name = x509.Name([x509.NameAttribute(NameOID.COMMON_NAME, cn)])
+    start = start or NOW - timedelta(days=2)
+    end = end or NOW + timedelta(days=2)
+    builder = (x509.CertificateBuilder().subject_name(name)
+               .issuer_name(issuer_cert.subject if issuer_cert else name)
+               .public_key(key.public_key()).serial_number(x509.random_serial_number())
+               .not_valid_before(start).not_valid_after(end)
+               .add_extension(x509.BasicConstraints(ca=ca, path_length=1 if ca else None), critical=True))
+    if ca:
+        builder = builder.add_extension(x509.KeyUsage(digital_signature=False, content_commitment=False,
+            key_encipherment=False, data_encipherment=False, key_agreement=False,
+            key_cert_sign=True, crl_sign=True, encipher_only=False, decipher_only=False), critical=True)
+    if san:
+        builder = builder.add_extension(x509.SubjectAlternativeName([x509.DNSName(san)]), critical=False)
+    if not ca:
+        builder = builder.add_extension(x509.ExtendedKeyUsage([x509.oid.ExtendedKeyUsageOID.SERVER_AUTH]), critical=False)
+    cert = builder.sign(issuer_key or key, hashes.SHA256())
+    return key, cert
+
+def pem_cert(cert): return cert.public_bytes(serialization.Encoding.PEM)
+def pem_key(key):
+    return key.private_bytes(serialization.Encoding.PEM, serialization.PrivateFormat.TraditionalOpenSSL,
+                             serialization.NoEncryption())
+
+class LoopbackTLS:
+    def __init__(self, cert_path, key_path, payload=b"OK", tls13=False, status=200):
+        self.payload = payload
+        self.status = status
+        self.listener = socket.socket()
+        self.listener.bind(("127.0.0.1", 0))
+        self.listener.listen(3)
+        self.listener.settimeout(0.15)
+        self.port = self.listener.getsockname()[1]
+        self.data = bytearray()
+        self.handshakes = 0
+        self.versions = []
+        self.stop = threading.Event()
+        self.ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
+        self.ctx.minimum_version = ssl.TLSVersion.TLSv1_3 if tls13 else ssl.TLSVersion.TLSv1_2
+        self.ctx.maximum_version = self.ctx.minimum_version
+        self.ctx.load_cert_chain(str(cert_path), str(key_path))
+        self.thread = threading.Thread(target=self.run, daemon=True)
+
+    def run(self):
+        while not self.stop.is_set():
+            try: raw, _ = self.listener.accept()
+            except socket.timeout: continue
+            try:
+                raw.settimeout(2)
+                with self.ctx.wrap_socket(raw, server_side=True) as peer:
+                    self.handshakes += 1
+                    self.versions.append(peer.version())
+                    try:
+                        peer.settimeout(0.3)
+                        expected = None
+                        while len(self.data) < 8192:
+                            data = peer.recv(8192 - len(self.data))
+                            if not data: break
+                            self.data.extend(data)
+                            if b"\r\n\r\n" in self.data and expected is None:
+                                headers, _ = bytes(self.data).split(b"\r\n\r\n", 1)
+                                length = 0
+                                for line in headers.split(b"\r\n")[1:]:
+                                    if line.lower().startswith(b"content-length:"):
+                                        length = int(line.split(b":", 1)[1].strip())
+                                expected = len(headers) + 4 + length
+                            if expected is not None and len(self.data) >= expected: break
+                        if expected is not None and len(self.data) >= expected:
+                            response = f"HTTP/1.1 {self.status} Fixture\r\nConnection: close\r\nContent-Length: ".encode()
+                            peer.sendall(response + str(len(self.payload)).encode() + b"\r\n\r\n" + self.payload)
+                    except (OSError, ssl.SSLError): pass
+            except (OSError, ssl.SSLError):
+                raw.close()
+
+    def __enter__(self): self.thread.start(); return self
+    def __exit__(self, *_):
+        self.stop.set()
+        self.thread.join(timeout=3)
+        self.listener.close()
+        if self.thread.is_alive(): raise RuntimeError("TLS fixture thread did not stop")
