+#include "TimedSleepPaint.h"
+
+#include <Bitmap.h>
+#include <GfxRenderer.h>
+#include <HalStorage.h>
+#include <Logging.h>
+#include <Memory.h>
+
+#include "PluginEventAsset.h"
+
+namespace timedsleeppaint {
+bool paint(GfxRenderer& renderer, const std::string& asset, const std::function<bool()>& shouldAbort) {
+  const auto aborted = [&] { return shouldAbort && shouldAbort(); };
+  const int width = renderer.getScreenWidth(), height = renderer.getScreenHeight();
+  const std::string staged = asset + ".part";
+  if (aborted() || !plugineventasset::validBmp(staged, width, height)) return false;
+  {
+    HalFile file;
+    if (!Storage.openFileForRead("TIMER", staged, file)) return false;
+    // Bitmap's 256-byte palette alone exceeds the small-stack budget.
+    auto bitmap = makeUniqueNoThrow<Bitmap>(file);
+    if (!bitmap) {
+      LOG_ERR("TIMER", "Bitmap allocation failed (%u bytes)", static_cast<unsigned>(sizeof(Bitmap)));
+      return false;
+    }
+    if (bitmap->parseHeaders() != BmpReaderError::Ok || bitmap->getWidth() != width || bitmap->getHeight() != height ||
+        aborted())
+      return false;
+    // Decode into the existing framebuffer before replacing the last-good file.
+    renderer.setRenderMode(GfxRenderer::BW);
+    renderer.clearScreen();
+    if (!renderer.drawBitmap(*bitmap, 0, 0, width, height) || aborted()) return false;
+  }
+  // The staged file must be closed before the existing checked rename.
+  // Once replacement starts, finish the transfer; Power is handled afterwards.
+  if (aborted() || !plugineventasset::commit(asset, width, height, 200)) return false;
+  renderer.displayBuffer(HalDisplay::HALF_REFRESH);
+  return true;
+}
+}  // namespace timedsleeppaint
