+#include <cassert>
+#include <cstdint>
+#include <cstdio>
+#include <string>
+
+#include "TimerWakeArm.h"
+#include "util/TimedWakeGuard.h"
+
+#ifndef TEST_TIMER_INTERVAL_US
+#define TEST_TIMER_INTERVAL_US 0
+#endif
+constexpr uint64_t TEST_INTERVAL = TEST_TIMER_INTERVAL_US;
+namespace {
+struct Reset {};
+struct Slept {};
+int armCalls, disableCalls, resetCalls, gpioArms, releaseWaits, sleeps;
+int armError, disableError;
+bool timerEnabled;
+uint64_t armedInterval;
+void clear() {
+  armCalls = disableCalls = resetCalls = gpioArms = releaseWaits = sleeps = 0;
+  armError = disableError = 0;
+  timerEnabled = false;
+  armedInterval = 0;
+}
+struct Hooks {
+  int checks = 0, pressAt = 0, batteryReads = 0;
+  int syncCalls = 0, prepareCalls = 0;
+  uint64_t configured = TEST_INTERVAL;
+  uint16_t battery = 80;
+  uint64_t interval = 99;
+  // Sentinels represent caller-owned state; the production guard has no route
+  // to write these or to invoke a renderer/network/storage operation.
+  const std::string readerState = "book.epub:chapter7:42%";
+  const std::string pixels = "retained sleep frame";
+  bool powerPressed() { return ++checks == pressAt; }
+  uint16_t batteryPercent() {
+    ++batteryReads;
+    return battery;
+  }
+  uint64_t prepare() {
+    ++prepareCalls;
+    return configured;
+  }
+  void sync() { ++syncCalls; }
+  void sleep(uint64_t value) {
+    interval = value;
+    timerwakearm::arm(value);
+    timerwakearm::sleep(true);
+  }
+};
+using W = wakeup::Reason;
+constexpr timedwake::Boot TIMER{W::Timer, wakeup::RST_DEEPSLEEP, true, false};
+bool run(timedwake::Boot boot, Hooks& hooks) {
+  try {
+    return timedwake::handleBoot(boot, hooks);
+  } catch (const Slept&) {
+    return true;
+  }
+}
+void classification() {
+  using wakeup::classify;
+  assert(classify(wakeup::WAKEUP_TIMER, wakeup::RST_DEEPSLEEP, false, true) == W::Timer);
+  assert(classify(wakeup::WAKEUP_TIMER, wakeup::RST_DEEPSLEEP, true, false) == W::Timer);
+  assert(classify(wakeup::WAKEUP_GPIO, wakeup::RST_DEEPSLEEP, false, true) == W::PowerButton);
+  assert(classify(wakeup::WAKEUP_EXT1, wakeup::RST_DEEPSLEEP, true, false) == W::PowerButton);
+  assert(classify(wakeup::WAKEUP_UNDEFINED, wakeup::RST_POWERON, false, true) == W::PowerButton);
+  assert(classify(wakeup::WAKEUP_UNDEFINED, wakeup::RST_POWERON, false, false) == W::Other);
+  assert(classify(wakeup::WAKEUP_UNDEFINED, wakeup::RST_POWERON, true, true) == W::AfterUSBPower);
+  assert(classify(wakeup::WAKEUP_UNDEFINED, wakeup::RST_UNKNOWN, true, true) == W::AfterFlash);
+  assert(classify(wakeup::WAKEUP_TIMER, wakeup::RST_SW, false, true) == W::Other);
+  assert(classify(wakeup::WAKEUP_UNDEFINED, wakeup::RST_DEEPSLEEP, false, true) == W::Other);
+}
+}  // namespace
+
+int esp_sleep_enable_timer_wakeup(uint64_t interval) {
+  ++armCalls;
+  armedInterval = interval;
+  timerEnabled = true;  // Even a failed arm may leave an earlier source enabled.
+  return armError;
+}
+int esp_sleep_disable_wakeup_source(int source) {
+  assert(source == ESP_SLEEP_WAKEUP_TIMER);
+  ++disableCalls;
+  if (disableError == ESP_OK || disableError == ESP_ERR_INVALID_STATE) timerEnabled = false;
+  return disableError;
+}
+[[noreturn]] void esp_restart() {
+  ++resetCalls;
+  timerEnabled = false;
+  throw Reset{};
+}
+bool freeink::PowerManager::armPowerButtonWakeup() {
+  ++gpioArms;
+  return true;
+}
+[[noreturn]] void freeink::PowerManager::deepSleep() {
+  ++sleeps;
+  throw Slept{};
+}
+[[noreturn]] void freeink::PowerManager::deepSleepUntilPowerButton() {
+  ++releaseWaits;
+  armPowerButtonWakeup();
+  deepSleep();
+}
+
+int main() {
+  bool verified = false;
+  uint32_t typedStamp = timedwake::VERIFIED_WAKE_STAMP;
+  assert(timedwake::consumeManualWake(wakeup::RST_SW, typedStamp, &verified) && verified && typedStamp == 0);
+  typedStamp = timedwake::VERIFIED_WAKE_STAMP;
+  assert(!timedwake::consumeManualWake(wakeup::RST_POWERON, typedStamp, &verified) && !verified && typedStamp == 0);
+  clear();
+  Hooks local;
+  local.battery = 5;
+  local.configured = 60000000ULL;
+  assert(run({W::Timer, wakeup::RST_DEEPSLEEP, true, false, 0}, local));
+  assert(local.prepareCalls == 1 && local.syncCalls == 1 && local.interval == 60000000ULL);
+  uint32_t stamp = timedwake::MANUAL_WAKE_STAMP;
+  assert(timedwake::consumeManualWake(wakeup::RST_SW, stamp) && stamp == 0);
+  assert(!timedwake::consumeManualWake(wakeup::RST_SW, stamp));
+  stamp = timedwake::MANUAL_WAKE_STAMP;
+  assert(!timedwake::consumeManualWake(wakeup::RST_POWERON, stamp) && stamp == 0);
+  stamp = 0xffffffff;
+  assert(!timedwake::consumeManualWake(wakeup::RST_SW, stamp) && stamp == 0);
+
+  classification();
+  // A latched short tap can release before settings load. Click-wake accepts
+  // it; hold-to-wake requires the existing stable hold verification.
+  assert(timedwake::acceptManualWake(false, true));
+  assert(!timedwake::acceptManualWake(false, false));
+  assert(timedwake::acceptManualWake(true, false));
+  clear();
+  Hooks first;
+  assert(run(TIMER, first));
+  assert(first.interval == TEST_INTERVAL);
+  assert(first.batteryReads == (TEST_INTERVAL ? 2 : 1));
+  assert(first.syncCalls == (TEST_INTERVAL ? 1 : 0));
+  assert(armCalls == (TEST_INTERVAL ? 1 : 0));
+  assert(sleeps == 1 && gpioArms == 1 && releaseWaits == 0);
+  assert(first.readerState == "book.epub:chapter7:42%" && first.pixels == "retained sleep frame");
+
+  clear();
+  timerEnabled = true;
+  Hooks deleted;
+  deleted.configured = 0;
+  assert(run(TIMER, deleted));
+  assert(deleted.interval == 0 && deleted.syncCalls == 0 && !timerEnabled && disableCalls == 1);
+  // A second reset/cycle rearms through the same primitive, not a running scheduler.
+  Hooks second;
+  assert(run(TIMER, second));
+  assert(sleeps == 2 && releaseWaits == 0);
+
+  for (auto reason : {W::PowerButton, W::AfterFlash, W::AfterUSBPower, W::Other}) {
+    clear();
+    Hooks h;
+    assert(!run({reason, wakeup::RST_DEEPSLEEP, true, false}, h));
+    assert(h.checks == 0 && armCalls == 0 && sleeps == 0);
+  }
+  for (int reset : {wakeup::RST_SW, wakeup::RST_UNKNOWN, wakeup::RST_POWERON}) {
+    clear();
+    Hooks h;
+    assert(!run({W::Timer, reset, true, false}, h));
+    assert(sleeps == 0);
+  }
+  clear();
+  Hooks rtc;
+  assert(run({W::RtcTimer, wakeup::RST_POWERON, true, false}, rtc));
+  assert(rtc.syncCalls == (TEST_INTERVAL ? 1 : 0) && sleeps == 1);
+  for (int reset : {wakeup::RST_SW, wakeup::RST_UNKNOWN, wakeup::RST_DEEPSLEEP, 9}) {
+    clear();
+    Hooks rejected;
+    assert(!run({W::RtcTimer, reset, true, false}, rejected));
+    assert(rejected.checks == 0 && sleeps == 0);
+  }
+  for (int pressAt : {1, 2}) {
+    clear();
+    Hooks h;
+    h.pressAt = pressAt;
+    assert(!run(TIMER, h));
+    assert(sleeps == 0 && armCalls == 0);  // Power before or during battery read wins.
+  }
+  for (auto boot : {timedwake::Boot{W::Timer, wakeup::RST_DEEPSLEEP, false, false},
+                    timedwake::Boot{W::Timer, wakeup::RST_DEEPSLEEP, true, true}}) {
+    clear();
+    timerEnabled = true;
+    Hooks h;
+    assert(run(boot, h));
+    assert(h.interval == 0 && h.batteryReads == 0 && h.prepareCalls == 0 && armCalls == 0 && sleeps == 1);
+    assert(!timerEnabled && disableCalls == 1 && resetCalls == 0);
+  }
+  if (TEST_INTERVAL) {
+    clear();
+    Hooks duringSync;
+    duringSync.pressAt = 3;
+    assert(!run(TIMER, duringSync));
+    assert(duringSync.syncCalls == 1 && sleeps == 0 && armCalls == 0);
+  }
+  clear();
+  timerEnabled = true;
+  Hooks low;
+  low.battery = 19;
+  assert(run(TIMER, low));
+  assert(low.interval == 0 && low.prepareCalls == 0 && armCalls == 0 && sleeps == 1);
+  assert(!timerEnabled && disableCalls == 1 && resetCalls == 0);
+  assert(timedwake::sleepInterval(TEST_INTERVAL, false, 100) == 0);
+  assert(timedwake::sleepInterval(TEST_INTERVAL, true, 19) == 0);
+  assert(timedwake::sleepInterval(TEST_INTERVAL, true, 20) == TEST_INTERVAL);
+
+  clear();
+  timerEnabled = true;
+  assert(!timerwakearm::arm(0));
+  assert(armCalls == 0 && disableCalls == 1 && !timerEnabled);
+  clear();
+  disableError = ESP_ERR_INVALID_STATE;  // Already inactive is a safe result.
+  assert(!timerwakearm::arm(0));
+  assert(!timerEnabled && disableCalls == 1 && resetCalls == 0);
+  clear();
+  assert(timerwakearm::arm(60000000));
+  assert(timerEnabled && armedInterval == 60000000);
+  clear();
+  armError = -1;
+  timerEnabled = true;
+  assert(!timerwakearm::arm(60000000));
+  assert(!timerEnabled && armCalls == 1 && disableCalls == 1 && resetCalls == 0);
+  try {
+    timerwakearm::sleep(true);
+  } catch (const Slept&) {
+  }
+  assert(sleeps == 1 && releaseWaits == 0 && !timerEnabled);  // Button-only, no retry.
+  clear();
+  armError = disableError = -1;
+  try {
+    timerwakearm::arm(60000000);
+    assert(false);
+  } catch (const Reset&) {
+  }
+  assert(resetCalls == 1 && sleeps == 0 && armCalls == 1 && disableCalls == 1);
+  Hooks afterAbort;
+  assert(!run({wakeup::classify(wakeup::WAKEUP_TIMER, wakeup::RST_SW, false, true), wakeup::RST_SW, true, false},
+              afterAbort));
+  assert(sleeps == 0);  // SDK sleep abort and cleanup restart are not timer loops.
+  clear();
+  try {
+    timerwakearm::sleep(false);
+  } catch (const Slept&) {
+  }
+  assert(releaseWaits == 1 && gpioArms == 1 && sleeps == 1);  // Existing normal helper.
+  std::puts(TEST_INTERVAL ? "lab-enabled guard/arm checks passed" : "default-disabled guard/arm checks passed");
+}
