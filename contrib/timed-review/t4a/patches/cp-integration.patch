+#!/usr/bin/env python3
+"""Run the real HAL/SDK RTC path; hardware bus and reset conditions are simulated."""
+from pathlib import Path
+import subprocess
+import tempfile
+root = Path(__file__).resolve().parents[2]
+here = Path(__file__).resolve().parent
+hardware = root / "freeink-sdk/libs/hardware"
+rtc = hardware / "Rtc"
+with tempfile.TemporaryDirectory(prefix="papermono-timer-") as tmp:
+    exe = Path(tmp) / "check"
+    args = ["c++", "-std=c++20", "-O0", "-Wall", "-Wextra", "-fsanitize=address,undefined",
+            "-fno-omit-frame-pointer", "-DFREEINK_DEVICE_PAPERMONO=1", "-DFREEINK_CAP_RTC=1"]
+    for p in (rtc/"test/host", rtc/"test/host/stubs", hardware/"BatteryMonitor/test/host/stubs",
+              rtc/"include", hardware/"BoardConfig/include", root/"lib/hal"):
+        args += ["-I", str(p)]
+    subprocess.run([*args, str(rtc/"src/Rtc.cpp"), str(here/"PaperMonoTimerTest.cpp"), "-o", str(exe)], check=True)
+    for case in range(7):
+        subprocess.run([str(exe), str(case)], check=True)
+print("PaperMono real HAL/SDK: 7 wake origins, arm/cancel and rollback PASS")
