diff --git a/test/plugin_verified_http/stubs/SecureHttpClient.h b/test/plugin_verified_http/stubs/SecureHttpClient.h
new file mode 100644
index 0000000..ea9370d
--- /dev/null
+++ b/test/plugin_verified_http/stubs/SecureHttpClient.h
@@ -0,0 +1,67 @@
+#pragma once
+#include <TrustedTime.h>
+
+#include <cassert>
+#include <cstdint>
+#include <functional>
+#include <string>
+#include <utility>
+#include <vector>
+namespace freeink {
+class SecureHttpClient {
+ public:
+#ifdef TEST_SDK_CAPABILITY
+  static bool peerVerificationAvailable() { return TEST_PEER_VERIFICATION_AVAILABLE != 0; }
+#endif
+  using DataCallback = std::function<bool(const uint8_t*, size_t)>;
+  using AbortCallback = std::function<bool()>;
+  struct Reply {
+    int status;
+    std::string body;
+    bool complete = true;
+  };
+  static inline int begins = 0, insecureCalls = 0, caCalls = 0, sends = 0;
+  static inline int status = 200;
+  static inline std::string reply;
+  static inline bool complete = true;
+  static inline std::vector<Reply> replies;
+  static inline uint32_t sendDelayMs = 0;
+  static inline bool abortAfterBody = false;
+  static inline std::vector<std::string> urls, headers, bodies;
+  const char* ca = nullptr;
+  void setUserAgent(const char*) {}
+  void setInsecure() { ++insecureCalls; }
+  void setCACert(const char* value) {
+    ca = value;
+    ++caCalls;
+  }
+  void setTimeout(uint32_t) {}
+  void setFollowRedirects(int hops) { assert(hops == 0); }
+  bool begin(const std::string& url) {
+    ++begins;
+    urls.push_back(url);
+    return true;
+  }
+  void addHeader(const std::string& name, const std::string& value) { headers.push_back(name + ":" + value); }
+  int sendRequest(const char*, const uint8_t* body, size_t length, const DataCallback& onData,
+                  const AbortCallback& abort = nullptr) {
+    if (abort && abort()) return -1;
+    if (ca) assert(std::string(ca).find("-----BEGIN CERTIFICATE-----") != std::string::npos);
+    bodies.emplace_back(reinterpret_cast<const char*>(body), length);
+    ++sends;
+    trustedtime::fixtureMs += sendDelayMs;
+    if (!replies.empty()) {
+      auto r = replies.front();
+      replies.erase(replies.begin());
+      status = r.status;
+      reply = r.body;
+      complete = r.complete;
+    }
+    if (!reply.empty() && !onData(reinterpret_cast<const uint8_t*>(reply.data()), reply.size())) complete = false;
+    if (abortAfterBody && abort && abort()) return -1;
+    return status;
+  }
+  bool responseComplete() const { return complete; }
+  std::vector<std::pair<std::string, std::string>> getHeaders() const { return {}; }
+};
+}  // namespace freeink
diff --git a/test/plugin_verified_http/stubs/TrustedTime.h b/test/plugin_verified_http/stubs/TrustedTime.h
new file mode 100644
index 0000000..a8b5c86
--- /dev/null
+++ b/test/plugin_verified_http/stubs/TrustedTime.h
@@ -0,0 +1,24 @@
+#pragma once
+#include <time.h>
+
+#include <cstdint>
+#include <functional>
+namespace trustedtime {
+inline int64_t now = 1800000000;
+inline int64_t systemNow = 1800000000;
+inline bool fresh = false;
+inline bool syncSucceeds = true;
+inline int syncAttempts = 0;
+inline uint32_t fixtureMs = 0;
+inline uint32_t syncDelayMs = 0;
+inline int64_t trustedNow() { return now; }
+inline bool hasFreshSync() { return fresh; }
+inline bool syncFresh(uint32_t, const std::function<bool()>& shouldAbort = nullptr) {
+  ++syncAttempts;
+  fixtureMs += syncDelayMs;
+  fresh = syncSucceeds && !(shouldAbort && shouldAbort());
+  return fresh;
+}
+}  // namespace trustedtime
