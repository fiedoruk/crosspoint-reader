+    return credential ? std::optional<Cred>(Cred{emptySsid ? "" : "fixture", ""}) : std::nullopt;
+  }
+} WIFI_STORE;
+constexpr int WL_CONNECTED = 1, WIFI_STA = 2, WIFI_OFF = 0;
+struct Wifi {
+  bool online = false, canJoin = true;
+  int begins = 0, modeValue = 0;
+  int status() { return online ? WL_CONNECTED : 0; }
+  void mode(int m) {
+    modeValue = m;
+    trace.push_back(m == WIFI_OFF ? "OFF" : "STA");
+  }
+  void begin(const char*, const char*) {
+    ++begins;
+    online = canJoin;
+    trace.push_back("JOIN");
