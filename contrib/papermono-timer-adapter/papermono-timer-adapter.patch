diff --git a/test/papermono_timer/PaperMonoTimerTest.cpp b/test/papermono_timer/PaperMonoTimerTest.cpp
new file mode 100644
index 0000000..890486e
--- /dev/null
+++ b/test/papermono_timer/PaperMonoTimerTest.cpp
@@ -0,0 +1,71 @@
+#include <PaperMonoTimer.h>
+#include <RecordingRtcBus.h>
+#include <WakeupClassify.h>
+
+#include <cstdlib>
+
+static int resetReason = wakeup::RST_POWERON;
+static int wakeCause = wakeup::WAKEUP_UNDEFINED;
+static bool usb = false;
+[[maybe_unused]] constexpr int ESP_RST_POWERON = wakeup::RST_POWERON;
+[[maybe_unused]] constexpr int ESP_SLEEP_WAKEUP_UNDEFINED = wakeup::WAKEUP_UNDEFINED;
+int esp_reset_reason() { return resetReason; }
+int esp_sleep_get_wakeup_cause() { return wakeCause; }
+#define LOG_ERR(...) ((void)0)
+struct HalGPIO {
+  using WakeupReason = wakeup::Reason;
+  bool isUsbConnected() const { return usb; }
+  bool coldBootImpliesPowerButton() const { return true; }
+  WakeupReason getWakeupReason() const;
+};
+#include "WakeSource.inc"
+
+int main(int argc, char** argv) {
+  assert(argc == 2 || argc == 3);
+  const int mode = std::atoi(argv[1]);
+  reset();
+  regs[0x6E][0x05] = mode == 1 ? 0x24 : mode == 2 ? 0x22 : 0x20;
+  regs[0x6E][0x18] = mode == 3 ? 0x11 : 0x01;
+  regs[0x32][0x1D] = mode == 4 ? 0 : mode == 5 ? 0x12 : 0x10;
+  regs[0x32][0x1C] = 0x12;
+  regs[0x32][0x1E] = 0x10;
+  if (mode == 6) deadBus = true;
+  usb = mode == 2;
+  if (mode >= 7 && mode <= 10) resetReason = mode == 7 ? 3 : mode == 8 ? 9 : mode == 9 ? 5 : 4;
+  if (mode == 11) wakeCause = wakeup::WAKEUP_EXT1;
+  if (mode == 12) regs[0x6E][0x05] = 0;
+  HalGPIO gpio;
+  const auto expected = mode == 0                 ? wakeup::Reason::Timer
+                        : mode == 2               ? wakeup::Reason::AfterUSBPower
+                        : mode >= 7 && mode <= 11 ? wakeup::Reason::Other
+                                                  : wakeup::Reason::PowerButton;
+  const auto actual = gpio.getWakeupReason();
+  if (argc == 3) return actual != expected ? 42 : 0;
+  assert(actual == expected);
+  const int afterFirstQuery = operations;
+  assert(gpio.getWakeupReason() == actual && operations == afterFirstQuery);
+  if (mode == 6) return 0;
+  assert(!(regs[0x32][0x1C] & 0x10) && !(regs[0x32][0x1E] & 0x10));
+  assert(!(regs[0x6E][0x18] & 1));
+  reset();
+  assert(papermonotimer::arm(60000000ULL));
+  assert((regs[0x32][0x1C] & 0x10) && regs[0x6E][0x18] == 1);
+  const int armedOperations = operations;
+  assert(gpio.getWakeupReason() == actual && operations == armedOperations);
+  assert(papermonotimer::arm(0));
+  assert(!(regs[0x32][0x1C] & 0x10) && regs[0x6E][0x18] == 0);
+  assert(!papermonotimer::arm(60000001ULL));
+  assert(papermonotimer::arm(65536ULL * 1000000ULL));
+  assert(regs[0x32][0x1A] == 0x45 && regs[0x32][0x1B] == 0x04);
+  assert(!papermonotimer::arm(3932101ULL * 1000000ULL));
+  assert(!(regs[0x32][0x1C] & 0x10) && !(regs[0x6E][0x18] & 1));
+  regs[0x6E][0x18] = 0x10;
+  regs[0x6E][0x07] = 0x20;
+  assert(!papermonotimer::arm(60000000ULL));
+  assert(regs[0x6E][0x18] == 0x10 && !(regs[0x32][0x1C] & 0x10));
+  assert(regs[0x6E][0x07] == 0x20);
+  reset();
+  dropCounter = true;
+  assert(!papermonotimer::arm(60000000ULL));
+  assert(!(regs[0x32][0x1C] & 0x10) && regs[0x6E][0x18] == 0);
+}
diff --git a/test/papermono_timer/SleepFlowTest.cpp b/test/papermono_timer/SleepFlowTest.cpp
new file mode 100644
index 0000000..2e73ecb
--- /dev/null
+++ b/test/papermono_timer/SleepFlowTest.cpp
@@ -0,0 +1,123 @@
+#include <cassert>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+#define FREEINK_DEVICE_PAPERMONO 1
+#define SOC_PM_SUPPORT_EXT1_WAKEUP 1
+#define ENABLE_SERIAL_LOG
+using gpio_num_t = int;
+constexpr int XTEINK_C3_GPIO13 = 13, OUTPUT = 1, HIGH = 1;
+struct PoweredOff {};
+struct Restarted {};
+static std::vector<std::string> trace;
+static bool armOk = true, cancelOk = true, removePower = true, shutdownOk = true;
+static uint64_t requested = 0;
+#define LOG_ERR(...) trace.push_back("error")
+struct HalGPIO {};
+struct HalPowerManager {
+  void startDeepSleep(HalGPIO&, uint64_t = 0) const;
+};
+struct Serial {
+  void end() { trace.push_back("serial-end"); }
+} logSerial;
+namespace BoardConfig {
+struct Profile {
+  struct Power {
+    int8_t latch0 = -1, latch1 = -1;
+  } power;
+} ACTIVE;
+}  // namespace BoardConfig
+void gpio_hold_dis(int) {}
+void gpio_hold_en(int) {}
+void pinMode(int, int) {}
+void digitalWrite(int, int) {}
+void delay(int ms) {
+  assert(ms == 1000);
+  trace.push_back("settle");
+}
+[[noreturn]] void esp_restart() {
+  trace.push_back("restart");
+  throw Restarted{};
+}
+namespace papermonotimer {
+bool arm(uint64_t us) {
+  requested = us;
+  trace.push_back("arm");
+  return armOk;
+}
+bool cancel() {
+  trace.push_back("cancel");
+  return cancelOk;
+}
+}  // namespace papermonotimer
+namespace freeink {
+struct PowerManager {
+  static void powerDownRailsForSleep() { trace.push_back("rails-off"); }
+  static void deepSleepUntilPowerButton() { assert(false && "PaperMono has no ESP Power wake pin"); }
+};
+namespace m5pm1 {
+bool requestShutdown() {
+  trace.push_back("shutdown");
+  if (removePower) throw PoweredOff{};
+  return shutdownOk;
+}
+}  // namespace m5pm1
+}  // namespace freeink
+#include "SleepSource.inc"
+
+int main() {
+  HalGPIO gpio;
+  HalPowerManager power;
+  try {
+    power.startDeepSleep(gpio, 60000000);
+    assert(false);
+  } catch (const PoweredOff&) {
+  }
+  assert(requested == 60000000);
+  assert((trace == std::vector<std::string>{"serial-end", "rails-off", "arm", "shutdown"}));
+  for (bool result : {false, true}) {
+    trace.clear();
+    removePower = false;
+    shutdownOk = result;
+    try {
+      power.startDeepSleep(gpio, 60000000);
+      assert(false);
+    } catch (const Restarted&) {
+    }
+    const std::vector<std::string> expected =
+        result ? std::vector<std::string>{"serial-end", "rails-off", "arm",   "shutdown",
+                                          "settle",     "cancel",    "error", "restart"}
+               : std::vector<std::string>{"serial-end", "rails-off", "arm", "shutdown", "cancel", "error", "restart"};
+    assert(trace == expected);
+  }
+  trace.clear();
+  armOk = false;
+  cancelOk = true;
+  removePower = true;
+  try {
+    power.startDeepSleep(gpio, 60000001);
+    assert(false);
+  } catch (const PoweredOff&) {
+  }
+  assert((trace == std::vector<std::string>{"serial-end", "rails-off", "arm", "error", "cancel", "shutdown"}));
+  trace.clear();
+  cancelOk = false;
+  try {
+    power.startDeepSleep(gpio, 60000000);
+    assert(false);
+  } catch (const Restarted&) {
+  }
+  assert((trace == std::vector<std::string>{"serial-end", "rails-off", "arm", "error", "cancel", "error", "restart"}));
+  trace.clear();
+  armOk = true;
+  cancelOk = true;
+  removePower = true;
+  try {
+    power.startDeepSleep(gpio);
+    assert(false);
+  } catch (const PoweredOff&) {
+  }
+  assert(requested == 0);
+  assert((trace == std::vector<std::string>{"serial-end", "rails-off", "arm", "shutdown"}));
+}
