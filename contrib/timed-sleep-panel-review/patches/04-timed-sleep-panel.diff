+    while (timeout && !abort()) {
+      delay(50);
+      timeout -= 50;
+    }
+    return false;
+  }
+  delay(clockElapsedMs);
+  fresh = !abort();
+  return fresh;
+}
+bool hasFreshSync() { return fresh; }
+}  // namespace trustedtime
+namespace BoardConfig {
+bool supported = true;
+bool isSticky() { return supported; }
+bool isX4Pro() { return false; }
+struct Profile {
+  int displayWidth = 800, displayHeight = 480;
+};
+static Profile ACTIVE;
+}  // namespace BoardConfig
+struct Cred {
+  std::string ssid, password;
+};
+struct WifiStore {
+  void loadFromFile() {}
+  std::string getLastConnectedSsid() { return "fixture"; }
+  std::optional<Cred> findCredential(const std::string&) {
+    return credential ? std::optional<Cred>(Cred{emptySsid ? "" : "fixture", ""}) : std::nullopt;
+  }
+} WIFI_STORE;
+constexpr int WL_CONNECTED = 1, WIFI_STA = 2, WIFI_OFF = 0;
+struct Wifi {
+  bool online = false, canJoin = true;
+  int begins = 0, modeValue = 0;
+  int status() { return online ? WL_CONNECTED : 0; }
+  void mode(int m) {
+    modeValue = m;
+    trace.push_back(m == WIFI_OFF ? "OFF" : "STA");
+  }
+  void begin(const char*, const char*) {
+    ++begins;
+    online = canJoin;
+    trace.push_back("JOIN");
+  }
+  void disconnect(bool) { online = false; }
+} WiFi;
+namespace pluginevents {
+enum class TimedState { NoHandler, Updated, Failure };
+struct Result {
+  TimedState state;
+  std::string asset;
+};
+static TimedState state = TimedState::Updated;
+void refreshSubscriptions() {}
+static bool prepared = false;
+void discardTimed() { prepared = false; }
+uint64_t prepareTimed(int width, int height) {
+  assert(width == 480 && height == 800);
+  prepared = handler;
+  return prepared ? 60000000ULL : 0;
+}
+Result timedSync(DrainBudget& budget, const std::function<bool()>& abort) {
+  assert(prepared);
+  prepared = false;
+  trace.push_back("FETCH");
+  if (!budget.beginAttempt()) return {TimedState::Failure, {}};
+  delay(fetchElapsedMs);
+  return {abort() ? TimedState::Failure : state, "/sleep.bmp"};
+}
+}  // namespace pluginevents
+static int renderer;
+static void setupBitmapDisplay(bool) {
+  ++initCalls;
+  timerDisplayReady = true;
+  trace.push_back("INIT");
+}
+namespace timedsleeppaint {
+bool paint(int&, const std::string&, const std::function<bool()>& abort) {
+  ++paintCalls;
+  trace.push_back("PAINT");
+  return !abort();
+}
+}  // namespace timedsleeppaint
+static bool syncTimerPanel();
+static uint64_t prepareTimerPanel();
+#include "TimerBootHooksSource.inc"
+#include "TimerPanelSource.inc"
+static bool runSync() {
+  if (timerHooks.powerPressed()) return true;
+  if (!timerHooks.prepare()) return false;
+  timerHooks.sync();
+  return timerHooks.manualPower;
+}
+static void reset() {
+  nowMs = 0;
+  pressAt = UINT32_MAX;
+  timerStorageReady = timerDisplayReady = false;
+  paintCalls = initCalls = 0;
+  timerDisplayStarted = false;
+  deepSleepInProgress = false;
+  timerHooks.manualPower = false;
+  handler = credential = true;
+  trustedtime::clockReady = true;
+  trustedtime::syncStarts = 0;
+  trustedtime::clockElapsedMs = 0;
+  trustedtime::fresh = false;
+  fetchElapsedMs = 0;
+  emptySsid = false;
+  Storage.ok = true;
+  Storage.mounted = false;
+  pluginevents::discardTimed();
+  powerManager.battery = 80;
+  powerManager.lastInterval = UINT64_MAX;
+  BoardConfig::supported = true;
+  WiFi = Wifi{};
+  trace.clear();
+  pluginevents::state = pluginevents::TimedState::Updated;
+}
+int main() {
+  reset();
+  Storage.ok = false;
+  assert(!runSync());
+  assert(WiFi.begins == 0 && initCalls == 0 && !timerStorageReady);
+  reset();
+  handler = false;
+  assert(!runSync());
+  assert(WiFi.begins == 0 && initCalls == 0);
+  reset();
+  credential = false;
+  assert(!runSync());
+  assert(WiFi.begins == 0 && initCalls == 0);
+  reset();
+  emptySsid = true;
+  assert(timerHooks.prepare() == 0);
+  assert(!pluginevents::prepared && WiFi.begins == 0 && trustedtime::syncStarts == 0);
+  reset();
+  assert(timerHooks.prepare());
+  emptySsid = true;  // Defensive recheck in the actual sync caller.
+  assert(!syncTimerPanel());
+  assert(!pluginevents::prepared && WiFi.begins == 0 && trustedtime::syncStarts == 0);
+  reset();
+  WiFi.canJoin = false;
+  assert(!runSync());
+  assert(nowMs == 10000 && initCalls == 0 && WiFi.modeValue == WIFI_OFF && trustedtime::syncStarts == 0);
+  reset();
+  pluginevents::state = pluginevents::TimedState::Failure;
+  assert(!runSync());
+  assert(initCalls == 0 && paintCalls == 0 && WiFi.modeValue == WIFI_OFF);
+  reset();
+  assert(!runSync());
+  assert(initCalls == 1 && paintCalls == 1 && timerStorageReady && timerDisplayReady);
+  assert(nowMs == 0 && trustedtime::syncStarts == 1);
+  assert(trace == std::vector<std::string>({"SD", "STA", "JOIN", "FETCH", "INIT", "PAINT", "OFF"}));
+  reset();
+  trustedtime::clockElapsedMs = 5000;
+  fetchElapsedMs = 10000;
+  assert(!runSync());
+  assert(nowMs == 15000 && trustedtime::syncStarts == 1);
+  assert(initCalls == 0 && paintCalls == 0 && WiFi.modeValue == WIFI_OFF);
+  reset();
+  trustedtime::clockElapsedMs = 4999;
+  fetchElapsedMs = 9999;
+  assert(!runSync());
+  assert(nowMs == 14998 && initCalls == 1 && paintCalls == 1);
+  reset();
+  powerManager.battery = 19;
+  assert(!runSync());
+  assert(initCalls == 0 && paintCalls == 0);
+  reset();
+  WiFi.canJoin = false;
+  pressAt = 200;
+  assert(runSync());
+  assert(initCalls == 0 && nowMs == 200 && WiFi.modeValue == WIFI_OFF && trustedtime::syncStarts == 0);
+  reset();
+  trustedtime::clockReady = false;
+  assert(!runSync());
+  assert(nowMs == 5000 && initCalls == 0 && paintCalls == 0 && WiFi.modeValue == WIFI_OFF);
+  for (const auto& event : trace) assert(event != "FETCH");
+  reset();
+  trustedtime::clockReady = false;
+  pressAt = 100;
+  assert(runSync());
+  assert(nowMs == 100 && initCalls == 0 && WiFi.modeValue == WIFI_OFF);
+  for (const auto& event : trace) assert(event != "FETCH");
+  reset();
+  pressAt = 0;
+  assert(runSync());
+  assert(trace.empty() && trustedtime::syncStarts == 0);
+  reset();
+  WiFi.canJoin = false;
+  pressAt = 200;
+  timerHooks.prepare();
+  timerHooks.sync();
+  pressAt = UINT32_MAX;
+  assert(timerHooks.powerPressed());  // Observed Power remains latched after release.
+  reset();
+  assert(timerHooks.prepare() == 60000000ULL);
+  assert(timerStorageReady && Storage.mounted && pluginevents::prepared);
+  assert(timerHooks.prepare() == 60000000ULL);
+  assert(trace == std::vector<std::string>({"SD"}));
+  pluginevents::discardTimed();
+  assert(!pluginevents::prepared);
+  reset();
+  timerStorageReady = timerDisplayStarted = true;
+  try {
+    timerHooks.sleep(60000000);
+    assert(false);
+  } catch (const Slept&) {
+  }
+  assert(trace == std::vector<std::string>({"DISPLAY_SLEEP", "SD_SLEEP", "SLEEP"}));
+  assert(deepSleepInProgress);
+  reset();
+  timerDisplayStarted = true;  // Partial display init still gets teardown.
+  try {
+    timerHooks.sleep(0);
+    assert(false);
+  } catch (const Slept&) {
+  }
+  assert(trace == std::vector<std::string>({"DISPLAY_SLEEP", "SLEEP"}));
+  reset();
+  timerStorageReady = timerDisplayStarted = true;
+  Storage.mounted = true;
+  try {
+    returnToTimerStandby();
+    assert(false);
+  } catch (const Slept&) {
+  }
+  assert(powerManager.lastInterval == 60000000ULL);
+  assert(trace == std::vector<std::string>({"LIGHT_OFF", "TILT_SLEEP", "DISPLAY_SLEEP", "SD_SLEEP", "SLEEP"}));
+  assert(!pluginevents::prepared);
+  reset();
+  timerStorageReady = timerDisplayStarted = true;
+  Storage.mounted = true;
+  handler = false;
+  try {
+    returnToTimerStandby();
+    assert(false);
+  } catch (const Slept&) {
+  }
+  assert(powerManager.lastInterval == 0 && !pluginevents::prepared);
+  assert(trace == std::vector<std::string>({"LIGHT_OFF", "TILT_SLEEP", "DISPLAY_SLEEP", "SD_SLEEP", "SLEEP"}));
+  reset();
+  timerStorageReady = timerDisplayStarted = true;
+  Storage.mounted = true;
+  powerManager.battery = 19;
+  try {
+    returnToTimerStandby();
+    assert(false);
+  } catch (const Slept&) {
+  }
+  assert(powerManager.lastInterval == 0 && !pluginevents::prepared);
+  assert(trace == std::vector<std::string>({"LIGHT_OFF", "TILT_SLEEP", "DISPLAY_SLEEP", "SD_SLEEP", "SLEEP"}));
+}
diff --git a/test/timed_sync/PaintTest.cpp b/test/timed_sync/PaintTest.cpp
new file mode 100644
index 00000000..123cfc48
--- /dev/null
+++ b/test/timed_sync/PaintTest.cpp
@@ -0,0 +1,57 @@
+#include <GfxRenderer.h>
+#include <HalStorage.h>
+
+#include <cassert>
+#include <string>
+
+#include "util/TimedSleepPaint.h"
+static std::string bmp() {
+  std::string bytes(94, '\0');
+  auto put = [&](int at, unsigned n) {
+    for (int i = 0; i < 4; ++i) bytes[at + i] = static_cast<char>(n >> (8 * i));
+  };
+  bytes[0] = 'B';
+  bytes[1] = 'M';
+  put(2, 94);
+  put(10, 62);
+  put(14, 40);
+  put(18, 8);
+  put(22, 8);
+  bytes[26] = 1;
+  bytes[28] = 1;
+  bytes[58] = bytes[59] = bytes[60] = static_cast<char>(255);
+  return bytes;
+}
+int main() {
+  const std::string path = "/sleep.bmp";
+  Storage.files[path] = bmp();
+  GfxRenderer ok;
+  assert(timedsleeppaint::paint(ok, path, {}));
+  assert(ok.paints == 1 && ok.draws == 1);
+  GfxRenderer bad;
+  bad.failDraw = true;
+  assert(!timedsleeppaint::paint(bad, path, {}));
+  assert(bad.paints == 0);
+  Storage.readStop = 70;
+  GfxRenderer shortRow;
+  assert(!timedsleeppaint::paint(shortRow, path, {}));
+  assert(shortRow.draws == 1 && shortRow.paints == 0);  // Header valid, later full decode fails.
+  Storage.readStop = SIZE_MAX;
+  GfxRenderer dim;
+  dim.width = 9;
+  assert(!timedsleeppaint::paint(dim, path, {}));
+  assert(dim.paints == 0);
+  Storage.files[path] = "bad";
+  GfxRenderer header;
+  assert(!timedsleeppaint::paint(header, path, {}));
+  assert(header.paints == 0);
+  Storage.files[path] = bmp();
+  GfxRenderer manual;
+  int checks = 0;
+  assert(!timedsleeppaint::paint(manual, path, [&] { return ++checks == 3; }));
+  assert(manual.draws == 1 && manual.paints == 0);  // Manual Power after full decode wins before transfer.
+  Storage.failRead = path;
+  GfxRenderer sd;
+  assert(!timedsleeppaint::paint(sd, path, {}));
+  assert(sd.paints == 0);
+}
