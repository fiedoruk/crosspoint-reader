+  Storage.files["/plugins/fixture/events.jsonl"] = R"({"e":"sleep.timer","vars":{}})"
+                                                   "\n";
+  pluginevents::drain(nullptr, 4);
+  assert(HTTP::sends == 0);
+  assert(!Storage.exists("/plugins/fixture/events.jsonl"));
+  setup("{}");
+  assert(!(pluginevents::prepareTimed(8, 8) != 0));
+  assert(runTimed(8, 8, {}).state == S::NoHandler);
+  setup();
+  assert(!(pluginevents::prepareTimed(9, 8) != 0));
+  assert(runTimed(9, 8, {}).state == S::Failure);
+  assert(HTTP::sends == 0);
+  setup();
+  PluginLocations::entries.push_back({"second", "/plugins/second", false, true, false});
