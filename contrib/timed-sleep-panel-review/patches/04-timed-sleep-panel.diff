+}  // namespace PluginLocations
+static const std::string history = R"({"e":"reader.session","vars":{"book":"private.epub"}})"
+                                   "\n";
+static const std::string manifest =
+    R"({"token":{"file":"token.json"},"events":{"sleep.timer":{"interval_seconds":60,"download":{"url":"https://fixture.invalid/{cfg.slot}?token={token}&id={event.id}","dest":"/sleep.bmp","format":"bmp","width":8,"height":8,"tls":{"ca_file":"ca.pem"}},"toast":"must never appear"},"reader.session":{"request":{"url":"https://fixture.invalid/history"}}},"config":{"file":"config.json"}})";
+static std::string bmp() {
+  std::string bytes(94, '\0');
+  auto put = [&](int at, unsigned n) {
+    for (int i = 0; i < 4; ++i) bytes[at + i] = static_cast<char>(n >> (8 * i));
+  };
+  bytes[0] = 'B';
+  bytes[1] = 'M';
+  put(2, 94);
+  put(10, 62);
+  put(14, 40);
+  put(18, 8);
+  put(22, 8);
+  bytes[26] = 1;
+  bytes[28] = 1;
+  bytes[58] = bytes[59] = bytes[60] = static_cast<char>(255);
+  return bytes;
+}
+static void setup(std::string mf = manifest) {
+  Storage = StorageStub{};
+  PluginLocations::entries = {{"fixture", "/plugins/fixture", false, true, false}};
+  Storage.files["/plugins/fixture/device.json"] = mf;
+  Storage.files["/plugins/fixture/events.jsonl"] = history;
+  Storage.files["/plugins/fixture/token.json"] = R"({"token":"fixture-token"})";
+  Storage.files["/plugins/fixture/config.json"] = R"({"slot":"frame"})";
+  Storage.files["/plugins/fixture/ca.pem"] =
+      "-----BEGIN CERTIFICATE-----\nfixture-not-a-real-certificate-pad\n-----END CERTIFICATE-----";
+  Storage.files["/sleep.bmp"] = bmp();
+  freeink::fakeNow = 0;
+  trustedtime::now = 1800000000;
+  trustedtime::systemNow = trustedtime::now;
+  trustedtime::fresh = true;  // main's fresh clock attempt precedes timedSync.
+  auto& replies = freeink::SecureHttpClient::replies;
+  replies = {{200, bmp(), 0}};
+  freeink::SecureHttpClient::sends = 0;
+  freeink::SecureHttpClient::insecureCalls = 0;
+  freeink::SecureHttpClient::caCalls = 0;
+  freeink::SecureHttpClient::aborted = false;
+  freeink::SecureHttpClient::beginOk = true;
